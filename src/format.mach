# image.format: identifiers for the image formats mach-image handles, and
# best-effort detection from a byte prefix.

use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;

# format tags. FORMAT_UNKNOWN is the zero value for an unrecognized or
# not-yet-detected format.
pub val FORMAT_UNKNOWN: u8 = 0;
pub val FORMAT_QOI:     u8 = 1;
pub val FORMAT_TGA:     u8 = 2;
pub val FORMAT_PNG:     u8 = 3;
pub val FORMAT_JPEG:    u8 = 4;

# format_name: the lowercase short name of a format tag, or "unknown".
# ---
# format: a FORMAT_* tag
# ret:    the format's short name
pub fun format_name(format: u8) str {
    if (format == FORMAT_QOI)  { ret "qoi"; }
    if (format == FORMAT_TGA)  { ret "tga"; }
    if (format == FORMAT_PNG)  { ret "png"; }
    if (format == FORMAT_JPEG) { ret "jpeg"; }
    ret "unknown";
}

# tga_footer_signature: the 18-byte signature of a TGA 2.0 file footer.
val tga_footer_signature: [18]u8 = [18]u8{
    'T', 'R', 'U', 'E', 'V', 'I', 'S', 'I', 'O', 'N',
    '-', 'X', 'F', 'I', 'L', 'E', '.', 0
};

# looks_like_tga: heuristic recognition of a TGA container from its header/footer.
#
# TGA has no leading magic, so detection is best-effort. a TGA 2.0 footer
# signature is a strong positive; otherwise the 18-byte header fields are
# range-checked against the known image and color-map types.
fun looks_like_tga(src: *u8, src_len: usize) u8 {
    if (src_len >= 26) {
        var i: usize = 0;
        var footer_ok: u8 = 1;
        for (i < 18) {
            if (src[src_len - 18 + i] != tga_footer_signature[i]) { footer_ok = 0; }
            i = i + 1;
        }
        if (footer_ok == 1) { ret 1; }
    }

    if (src_len < 18) { ret 0; }

    val color_map_type: u8 = src[1];
    val image_type:     u8 = src[2];
    val depth:          u8 = src[16];

    if (color_map_type > 1) { ret 0; }
    if (image_type != 1 && image_type != 2 && image_type != 3
        && image_type != 9 && image_type != 10 && image_type != 11) { ret 0; }
    if (depth != 8 && depth != 15 && depth != 16 && depth != 24 && depth != 32) { ret 0; }
    ret 1;
}

# detect: best-effort identification of an image format from its leading bytes.
#
# QOI is identified by its "qoif" magic. TGA has no magic, so it is recognized
# heuristically (footer signature or plausible header) and may match a variant
# the TGA decoder does not support — detection names the container, not
# decodability. returns FORMAT_UNKNOWN when nothing matches.
# ---
# src:     pointer to the leading bytes of the encoded image
# src_len: number of bytes available at src
# ret:     a FORMAT_* tag
pub fun detect(src: *u8, src_len: usize) u8 {
    if (src == nil) { ret FORMAT_UNKNOWN; }
    if (src_len >= 4 && src[0] == 'q' && src[1] == 'o' && src[2] == 'i' && src[3] == 'f') {
        ret FORMAT_QOI;
    }
    if (looks_like_tga(src, src_len) == 1) { ret FORMAT_TGA; }
    ret FORMAT_UNKNOWN;
}

test "format: known names" {
    if (!str_equals(format_name(FORMAT_QOI), "qoi"))   { ret 1; }
    if (!str_equals(format_name(FORMAT_TGA), "tga"))   { ret 1; }
    if (!str_equals(format_name(FORMAT_PNG), "png"))   { ret 1; }
    if (!str_equals(format_name(FORMAT_JPEG), "jpeg")) { ret 1; }
    ret 0;
}

test "format: unknown falls through" {
    if (!str_equals(format_name(FORMAT_UNKNOWN), "unknown")) { ret 1; }
    if (!str_equals(format_name(200), "unknown"))           { ret 1; }
    ret 0;
}

test "format: detect qoi magic" {
    var buf: [14]u8 = [14]u8{'q', 'o', 'i', 'f', 0, 0, 0, 1, 0, 0, 0, 1, 4, 0};
    if (detect(?buf[0], 14) != FORMAT_QOI) { ret 1; }
    ret 0;
}

test "format: detect tga by header heuristic" {
    var buf: [18]u8;
    buf[1]  = 0;   # color_map_type: none
    buf[2]  = 2;   # image_type: uncompressed truecolor
    buf[16] = 32;  # pixel depth
    if (detect(?buf[0], 18) != FORMAT_TGA) { ret 1; }
    ret 0;
}

test "format: detect rejects garbage and nil" {
    var buf: [4]u8 = [4]u8{0xDE, 0xAD, 0xBE, 0xEF};
    if (detect(?buf[0], 4) != FORMAT_UNKNOWN) { ret 1; }
    if (detect(nil, 100) != FORMAT_UNKNOWN)   { ret 1; }
    ret 0;
}
