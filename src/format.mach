# identifiers for the image formats mach-image handles, and
# best-effort detection from a byte prefix

use std.types.option.opt;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;
use image.codec.same_case;
use image.png.PNG_SIGNATURE;

# an image container format
# ---
# qoi:  Quite OK Image
# tga:  Truevision TGA
# png:  Portable Network Graphics
# jpeg: JPEG/JFIF, recognized by its start-of-image marker but not yet decoded
pub tag Format: u8 {
    qoi;
    tga;
    png;
    jpeg;
}

# the lowercase short name of a format
# ---
# format: the format to name
# ret:    the format's short name
pub fun format_name(format: Format) str {
    if (sel format.qoi) { ret "qoi"; }
    if (sel format.tga) { ret "tga"; }
    if (sel format.png) { ret "png"; }
    ret "jpeg";
}

# the 18-byte signature of a TGA 2.0 file footer
val tga_footer_signature: [18]u8 = [18]u8{
    'T', 'R', 'U', 'E', 'V', 'I', 'S', 'I', 'O', 'N',
    '-', 'X', 'F', 'I', 'L', 'E', '.', 0
};

# heuristic recognition of a TGA container from its header/footer
#
# TGA has no leading magic, so detection is best-effort. a TGA 2.0 footer
# signature is a strong positive; otherwise the 18-byte header fields are
# range-checked against the known image and color-map types.
fun looks_like_tga(src: *u8, src_len: usize) u8 {
    if (src_len >= 26) {
        var i: usize = 0;
        var footer_ok: u8 = 1;
        for (i < 18) {
            if (src[src_len - 18 + i] != tga_footer_signature[i]) { footer_ok = 0; }
            i = i + 1;
        }
        if (footer_ok == 1) { ret 1; }
    }

    if (src_len < 18) { ret 0; }

    val color_map_type: u8 = src[1];
    val image_type:     u8 = src[2];
    val depth:          u8 = src[16];

    if (color_map_type > 1) { ret 0; }
    if (image_type != 1 && image_type != 2 && image_type != 3
        && image_type != 9 && image_type != 10 && image_type != 11) { ret 0; }
    if (depth != 8 && depth != 15 && depth != 16 && depth != 24 && depth != 32) { ret 0; }
    ret 1;
}

# best-effort identification of an image format from its leading bytes
#
# QOI, PNG and JPEG are identified by their magic. TGA has no magic, so it is
# recognized heuristically (footer signature or plausible header) and may match
# a variant the TGA decoder does not support; detection names the container, not
# decodability, so it is tried last.
# ---
# src:     pointer to the leading bytes of the encoded image
# src_len: number of bytes available at src
# ret:     the detected format, or none when nothing matches
pub fun detect(src: *u8, src_len: usize) opt[Format] {
    if (src_len >= 4 && src[0] == 'q' && src[1] == 'o' && src[2] == 'i' && src[3] == 'f') {
        ret opt[Format].some{Format.qoi{}};
    }
    if (src_len >= 8) {
        var i: usize = 0;
        var png_ok: u8 = 1;
        for (i < 8) {
            if (src[i] != PNG_SIGNATURE[i]) { png_ok = 0; }
            i = i + 1;
        }
        if (png_ok == 1) { ret opt[Format].some{Format.png{}}; }
    }
    if (src_len >= 3 && src[0] == 0xFF && src[1] == 0xD8 && src[2] == 0xFF) {
        ret opt[Format].some{Format.jpeg{}};
    }
    if (looks_like_tga(src, src_len) == 1) { ret opt[Format].some{Format.tga{}}; }
    ret opt[Format].none{};
}

# whether detect names the expected format
fun detects(src: *u8, src_len: usize, want: Format) u8 {
    val got: opt[Format] = detect(src, src_len);
    if (!sel got.some) { ret 0; }
    if (!same_case[Format](got.some, want)) { ret 0; }
    ret 1;
}

test "format: known names" {
    if (!str_equals(format_name(Format.qoi{}), "qoi"))   { ret 1; }
    if (!str_equals(format_name(Format.tga{}), "tga"))   { ret 2; }
    if (!str_equals(format_name(Format.png{}), "png"))   { ret 3; }
    if (!str_equals(format_name(Format.jpeg{}), "jpeg")) { ret 4; }
    ret 0;
}

test "format: detect qoi magic" {
    var buf: [14]u8 = [14]u8{'q', 'o', 'i', 'f', 0, 0, 0, 1, 0, 0, 0, 1, 4, 0};
    if (detects(?buf[0], 14, Format.qoi{}) == 0) { ret 1; }
    ret 0;
}

test "format: detect tga by header heuristic" {
    var buf: [18]u8;
    buf[1]  = 0;   # color_map_type: none
    buf[2]  = 2;   # image_type: uncompressed truecolor
    buf[16] = 32;  # pixel depth
    if (detects(?buf[0], 18, Format.tga{}) == 0) { ret 1; }
    ret 0;
}

test "format: detect png signature" {
    var buf: [8]u8 = [8]u8{137, 80, 78, 71, 13, 10, 26, 10};
    if (detects(?buf[0], 8, Format.png{}) == 0) { ret 1; }
    # a signature the transfer-corruption check is meant to catch is not a PNG
    buf[2] = 0;
    if (detects(?buf[0], 8, Format.png{}) != 0) { ret 2; }
    ret 0;
}

test "format: detect jpeg start-of-image marker" {
    var buf: [4]u8 = [4]u8{0xFF, 0xD8, 0xFF, 0xE0};
    if (detects(?buf[0], 4, Format.jpeg{}) == 0) { ret 1; }
    ret 0;
}

test "format: detect rejects garbage" {
    var buf: [4]u8 = [4]u8{0xDE, 0xAD, 0xBE, 0xEF};
    val got: opt[Format] = detect(?buf[0], 4);
    if (!sel got.none) { ret 1; }
    ret 0;
}
