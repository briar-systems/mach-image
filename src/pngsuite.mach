# the pointer, length, and dimensions of the i-th entry backing
# pngsuite_hashes, or nil past the end
# ---
# i:      index into pngsuite_hashes, 0-based
# out_len: set to the entry's byte length
# out_w:   set to the entry's expected width
# out_h:   set to the entry's expected height
# ret:     pointer to the entry's encoded bytes, or nil if i is out of range
pub fun pngsuite_decodable(i: usize, out_len: *usize, out_w: *u32, out_h: *u32) *u8 {
    if (i == 0) { out_len[0] = 2262; out_w[0] = 256; out_h[0] = 256; ret ?pngsuite_png[0]; }
    if (i == 1) { out_len[0] = 217; out_w[0] = 32; out_h[0] = 32; ret ?basi0g01_png[0]; }
    if (i == 2) { out_len[0] = 154; out_w[0] = 32; out_h[0] = 32; ret ?basi0g02_png[0]; }
    if (i == 3) { out_len[0] = 247; out_w[0] = 32; out_h[0] = 32; ret ?basi0g04_png[0]; }
    if (i == 4) { out_len[0] = 254; out_w[0] = 32; out_h[0] = 32; ret ?basi0g08_png[0]; }
    if (i == 5) { out_len[0] = 299; out_w[0] = 32; out_h[0] = 32; ret ?basi0g16_png[0]; }
    if (i == 6) { out_len[0] = 315; out_w[0] = 32; out_h[0] = 32; ret ?basi2c08_png[0]; }
    if (i == 7) { out_len[0] = 595; out_w[0] = 32; out_h[0] = 32; ret ?basi2c16_png[0]; }
    if (i == 8) { out_len[0] = 132; out_w[0] = 32; out_h[0] = 32; ret ?basi3p01_png[0]; }
    if (i == 9) { out_len[0] = 193; out_w[0] = 32; out_h[0] = 32; ret ?basi3p02_png[0]; }
    if (i == 10) { out_len[0] = 327; out_w[0] = 32; out_h[0] = 32; ret ?basi3p04_png[0]; }
    if (i == 11) { out_len[0] = 1527; out_w[0] = 32; out_h[0] = 32; ret ?basi3p08_png[0]; }
    if (i == 12) { out_len[0] = 214; out_w[0] = 32; out_h[0] = 32; ret ?basi4a08_png[0]; }
    if (i == 13) { out_len[0] = 2855; out_w[0] = 32; out_h[0] = 32; ret ?basi4a16_png[0]; }
    if (i == 14) { out_len[0] = 361; out_w[0] = 32; out_h[0] = 32; ret ?basi6a08_png[0]; }
