# the shared currency every codec speaks
#
# a decoded image is always RGBA8, row-major, top-left origin, regardless of
# the source format's native channel count or scanline order. buffers are
# caller-supplied: decoders never allocate; callers size storage with
# image_byte_len after an *_info header parse.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;
use std.types.size.usize;
use std.types.string.str;

# colorspace hint carried through from source metadata
#
# informational only: mach-image performs no colorspace conversion. pixels are
# stored exactly as decoded (see the library's color-management non-goal).
pub val COLORSPACE_SRGB:   u8 = 0;
pub val COLORSPACE_LINEAR: u8 = 1;

# an RGBA8 pixel buffer with its dimensions and source metadata
#
# the common currency of the library. every decoder normalizes to this shape:
# RGBA8, row-major, top-left origin. pixels is a caller-owned buffer of
# image_byte_len(width, height) bytes that the record borrows and never frees.
# ---
# pixels:     width*height*4 bytes, R,G,B,A per pixel, top-left origin
# width:      image width in pixels
# height:     image height in pixels
# channels:   source channel count (3 or 4), informational after normalization
# colorspace: COLORSPACE_* hint from the source, informational
pub rec Image {
    pixels:     *u8;
    width:      u32;
    height:     u32;
    channels:   u8;
    colorspace: u8;
}

# bytes required for the RGBA8 buffer of a width x height image
# ---
# width:  image width in pixels
# height: image height in pixels
# ret:    required buffer size in bytes, or none for a zero dimension or when
#         width*height*4 would overflow usize
pub fun image_byte_len(width: u32, height: u32) opt[usize] {
    val w: usize = width::usize;
    val h: usize = height::usize;
    if (w == 0 || h == 0) { ret opt[usize].none{}; }
    val pixels: usize = w * h;
    if (pixels / w != h)          { ret opt[usize].none{}; }
    if (pixels > ~(0::usize) / 4) { ret opt[usize].none{}; }
    ret opt[usize].some{pixels * 4};
}

# why a decode or header parse was refused
# ---
# truncated:     input ended before the stream was complete
# bad_magic:     signature or magic bytes did not match the format
# bad_header:    a header field or the chunk structure was invalid
# short_buffer:  the destination is smaller than the image; carries the bytes
#                image_byte_len requires
# short_scratch: the working buffer is smaller than the decoder needs; carries
#                the bytes required
# unsupported:   a valid variant of the format this decoder does not implement
# corrupt:       the stream is well-formed but failed an integrity check
pub tag DecodeError: u8 {
    truncated;
    bad_magic;
    bad_header;
    short_buffer:  usize;
    short_scratch: usize;
    unsupported;
    corrupt;
}

# a short lowercase name for a DecodeError
# ---
# e:   the error to name
# ret: the case's short name
pub fun decode_error_name(e: DecodeError) str {
    if (sel e.truncated)     { ret "truncated"; }
    if (sel e.bad_magic)     { ret "bad-magic"; }
    if (sel e.bad_header)    { ret "bad-header"; }
    if (sel e.short_buffer)  { ret "short-buffer"; }
    if (sel e.short_scratch) { ret "short-scratch"; }
    if (sel e.unsupported)   { ret "unsupported"; }
    ret "corrupt";
}

# why an encode or its size bound was refused
# ---
# empty:        a dimension is zero
# too_large:    the dimensions exceed what the format or usize can represent
# channels:     the image's channel count is not 3 or 4
# colorspace:   the image's colorspace is not a COLORSPACE_* value
# short_buffer: the destination is smaller than the encoding; carries the bytes
#               required
pub tag EncodeError: u8 {
    empty;
    too_large;
    channels;
    colorspace;
    short_buffer: usize;
}

# a short lowercase name for an EncodeError
# ---
# e:   the error to name
# ret: the case's short name
pub fun encode_error_name(e: EncodeError) str {
    if (sel e.empty)      { ret "empty"; }
    if (sel e.too_large)  { ret "too-large"; }
    if (sel e.channels)   { ret "channels"; }
    if (sel e.colorspace) { ret "colorspace"; }
    ret "short-buffer";
}

# whether two values of one tag hold the same case, payloads ignored
# ---
# a:   first value
# b:   second value
# ret: true when both select the same case
#[testing]
pub fun same_case[T](a: T, b: T) bool {
    $each c in $cases(T) {
        if (sel a.[c] && sel b.[c]) { ret true; }
    }
    ret false;
}

test image_byte_len__bounds {
    val a: opt[usize] = image_byte_len(2, 3);
    if (!sel a.some)  { ret 1; }
    if (a.some != 24) { ret 1; }
    val b: opt[usize] = image_byte_len(0, 10);
    if (!sel b.none) { ret 2; }
    val c: opt[usize] = image_byte_len(10, 0);
    if (!sel c.none) { ret 3; }
    val d: opt[usize] = image_byte_len(0xFFFFFFFF, 0xFFFFFFFF);
    if (!sel d.none) { ret 4; }
    ret 0;
}

test same_case__ignores_payloads {
    if (!same_case[DecodeError](DecodeError.short_buffer{1}, DecodeError.short_buffer{2})) { ret 1; }
    if (same_case[DecodeError](DecodeError.short_buffer{1}, DecodeError.short_scratch{1})) { ret 2; }
    if (same_case[DecodeError](DecodeError.truncated{}, DecodeError.corrupt{}))            { ret 3; }
    ret 0;
}
