# the shared currency every codec speaks
#
# a decoded image is always RGBA8, row-major, top-left origin, regardless of
# the source format's native channel count or scanline order. buffers are
# caller-supplied: decoders never allocate; callers size storage with
# image_byte_len after an *_info header parse.

use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;

# colorspace hint carried through from source metadata
#
# informational only: mach-image performs no colorspace conversion. pixels are
# stored exactly as decoded (see the library's color-management non-goal).
pub val COLORSPACE_SRGB:   u8 = 0;
pub val COLORSPACE_LINEAR: u8 = 1;

# an RGBA8 pixel buffer with its dimensions and source metadata
#
# the common currency of the library. every decoder normalizes to this shape:
# RGBA8, row-major, top-left origin. pixels is a caller-owned buffer of
# image_byte_len(width, height) bytes that the record borrows and never frees.
# ---
# pixels:     width*height*4 bytes, R,G,B,A per pixel, top-left origin
# width:      image width in pixels
# height:     image height in pixels
# channels:   source channel count (3 or 4), informational after normalization
# colorspace: COLORSPACE_* hint from the source, informational
pub rec Image {
    pixels:     *u8;
    width:      u32;
    height:     u32;
    channels:   u8;
    colorspace: u8;
}

# bytes required for the RGBA8 buffer of a width x height image
#
# returns 0 for a zero dimension or when width*height*4 would overflow usize,
# so a 0 result always means "cannot represent" and is never a valid size.
# ---
# width:  image width in pixels
# height: image height in pixels
# ret:    required buffer size in bytes, or 0 if unrepresentable
pub fun image_byte_len(width: u32, height: u32) usize {
    val w: usize = width::usize;
    val h: usize = height::usize;
    if (w == 0 || h == 0) { ret 0; }
    val pixels: usize = w * h;
    if (pixels / w != h) { ret 0; }
    if (pixels > ~(0::usize) / 4) { ret 0; }
    ret pixels * 4;
}

# the result of a decode attempt, DECODE_OK on success
pub def DecodeStatus: u8;

# decode status codes
# ---
# DECODE_OK:           decode succeeded
# DECODE_TRUNCATED:    input ended before the stream was complete
# DECODE_BAD_MAGIC:    signature or magic bytes did not match the format
# DECODE_BAD_HEADER:   a header field was invalid (bad dimension, channels, ...)
# DECODE_SHORT_BUFFER: the destination buffer was smaller than image_byte_len
# DECODE_UNSUPPORTED:  a valid but unsupported variant of the format
# DECODE_CORRUPT:      the stream is well-formed but failed an integrity check
pub val DECODE_OK:           DecodeStatus = 0;
pub val DECODE_TRUNCATED:    DecodeStatus = 1;
pub val DECODE_BAD_MAGIC:    DecodeStatus = 2;
pub val DECODE_BAD_HEADER:   DecodeStatus = 3;
pub val DECODE_SHORT_BUFFER: DecodeStatus = 4;
pub val DECODE_UNSUPPORTED:  DecodeStatus = 5;
pub val DECODE_CORRUPT:      DecodeStatus = 6;

# a short lowercase name for a DecodeStatus
# ---
# status: a DECODE_* code
# ret:    the status's short name, or "unknown"
pub fun decode_status_name(status: DecodeStatus) str {
    if (status == DECODE_OK)           { ret "ok"; }
    if (status == DECODE_TRUNCATED)    { ret "truncated"; }
    if (status == DECODE_BAD_MAGIC)    { ret "bad-magic"; }
    if (status == DECODE_BAD_HEADER)   { ret "bad-header"; }
    if (status == DECODE_SHORT_BUFFER) { ret "short-buffer"; }
    if (status == DECODE_UNSUPPORTED)  { ret "unsupported"; }
    if (status == DECODE_CORRUPT)      { ret "corrupt"; }
    ret "unknown";
}

test "codec: image_byte_len basic" {
    if (image_byte_len(1, 1) != 4)   { ret 1; }
    if (image_byte_len(2, 3) != 24)  { ret 1; }
    if (image_byte_len(16, 16) != 1024) { ret 1; }
    ret 0;
}

test "codec: image_byte_len zero dimension is unrepresentable" {
    if (image_byte_len(0, 10) != 0) { ret 1; }
    if (image_byte_len(10, 0) != 0) { ret 1; }
    ret 0;
}

test "codec: image_byte_len rejects overflow" {
    if (image_byte_len(0xFFFFFFFF, 0xFFFFFFFF) != 0) { ret 1; }
    ret 0;
}

test "codec: status names" {
    if (!str_equals(decode_status_name(DECODE_OK), "ok"))                { ret 1; }
    if (!str_equals(decode_status_name(DECODE_TRUNCATED), "truncated"))  { ret 1; }
    if (!str_equals(decode_status_name(DECODE_SHORT_BUFFER), "short-buffer")) { ret 1; }
    if (!str_equals(decode_status_name(DECODE_CORRUPT), "corrupt"))      { ret 1; }
    if (!str_equals(decode_status_name(200), "unknown"))                 { ret 1; }
    ret 0;
}
