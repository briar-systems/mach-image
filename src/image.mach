# the flat public surface of mach-image
#
# a bare `use image;` reaches the whole API under one namespace, e.g.
# image.VERSION, image.Format, image.format_name(...).

use image.codec;
use image.format;
use image.png;
use image.qoi;
use image.tga;
use std.types.string.str;
# links the startup entrypoint so `mach test` over this library produces a binary.
use std.runtime;

# the mach-image release this source corresponds to
pub val VERSION: str = "0.5.0";

fwd format.Format;
fwd format.format_name;
fwd format.detect;

fwd codec.Image;
fwd codec.COLORSPACE_SRGB;
fwd codec.COLORSPACE_LINEAR;
fwd codec.image_byte_len;
fwd codec.DecodeError;
fwd codec.decode_error_name;
fwd codec.EncodeError;
fwd codec.encode_error_name;

fwd qoi.qoi_info;
fwd qoi.qoi_decode;
fwd qoi.qoi_encode;
fwd qoi.qoi_encode_bound;

fwd tga.tga_info;
fwd tga.tga_decode;
fwd tga.tga_encode;
fwd tga.tga_encode_bound;

fwd png.png_info;
fwd png.png_decode;
fwd png.png_scratch_len;
fwd png.png_encode;
fwd png.png_encode_bound;
fwd png.PNG_SIGNATURE;
fwd png.PNG_COLOR_GRAY;
fwd png.PNG_COLOR_RGB;
fwd png.PNG_COLOR_PALETTE;
fwd png.PNG_COLOR_GRAY_ALPHA;
fwd png.PNG_COLOR_RGBA;
