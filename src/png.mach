# the PNG codec: decoder
#
# a PNG is an 8-byte signature followed by a chain of length-prefixed,
# CRC-protected chunks. IHDR carries the dimensions and pixel format, PLTE the
# palette, tRNS the transparency, and one or more IDAT chunks carry a single
# zlib stream split at arbitrary points. inflating that stream yields the raw
# raster: one filter byte per scanline followed by the scanline's bytes, with
# an interlaced image splitting the raster into seven Adam7 passes.
#
# this module decodes bit depths 8 and 16 across all five color types, the five
# scanline filters, and both interlace methods, normalizing everything to RGBA8.
# 16-bit samples are reduced to 8 bits by keeping the high byte. sub-byte depths
# (1, 2, 4) are valid PNG this decoder does not handle and are rejected as
# DECODE_UNSUPPORTED rather than decoded wrongly. every chunk's CRC is verified.

use std.types.size.usize;
use std.types.string.str;
use std.types.bool.bool;
use O:   std.types.option;
use std.memory.raw_copy;
use std.memory.raw_equal;
use A:   std.allocator;
use FIX: std.allocator.fixed;
use R:   std.types.result;
use Z:   std.compress.inflate;
use ZL:  std.compress.zlib;
use crc: std.crypto.hash.crc32;
use image.codec.Image;
use image.codec.image_byte_len;
use image.codec.COLORSPACE_SRGB;
use image.codec.DecodeStatus;
use image.codec.DECODE_OK;
use image.codec.DECODE_TRUNCATED;
use image.codec.DECODE_BAD_MAGIC;
use image.codec.DECODE_BAD_HEADER;
use image.codec.DECODE_SHORT_BUFFER;
use image.codec.DECODE_UNSUPPORTED;
use image.codec.DECODE_CORRUPT;

val PNG_SIG_LEN:    usize = 8;
val PNG_IHDR_LEN:   usize = 13;
val PNG_CHUNK_OVER: usize = 12;   # length + type + crc around every payload

# the fixed 8-byte PNG signature
#
# the trailing CR/LF/EOF bytes are deliberate: they make a file mangled by a
# text-mode transfer fail the check instead of decoding to garbage.
pub val PNG_SIGNATURE: [8]u8 = [8]u8{137, 80, 78, 71, 13, 10, 26, 10};

pub val PNG_COLOR_GRAY:       u8 = 0;
pub val PNG_COLOR_RGB:        u8 = 2;
pub val PNG_COLOR_PALETTE:    u8 = 3;
pub val PNG_COLOR_GRAY_ALPHA: u8 = 4;
pub val PNG_COLOR_RGBA:       u8 = 6;

# Adam7 pass geometry: the first pixel each pass covers and its stride
val adam7_x_start: [7]u8 = [7]u8{0, 4, 0, 2, 0, 1, 0};
val adam7_y_start: [7]u8 = [7]u8{0, 0, 4, 0, 2, 0, 1};
val adam7_x_step:  [7]u8 = [7]u8{8, 8, 4, 4, 2, 2, 1};
val adam7_y_step:  [7]u8 = [7]u8{8, 8, 8, 4, 4, 2, 2};

# scratch the sliding window needs, plus slack for the allocator's alignment
#
# a zlib Decompressor wraps an Inflater and makes that one window allocation and
# nothing else, so the inflate layer's constant is the whole budget.
val PNG_WINDOW_SCRATCH: usize = Z.WINDOW + 64;

fun read_be32(p: *u8, off: usize) u32 {
    ret (p[off]::u32 << 24) | (p[off + 1]::u32 << 16) | (p[off + 2]::u32 << 8) | p[off + 3]::u32;
}

fun read_be16(p: *u8, off: usize) u16 {
    ret (p[off]::u16 << 8) | p[off + 1]::u16;
}

# a*b, or 0 when the product overflows usize
#
# mirrors image_byte_len's convention: a 0 result always means "cannot
# represent" and is never a valid size.
fun mul_checked(a: usize, b: usize) usize {
    if (a == 0 || b == 0) { ret 0; }
    val p: usize = a * b;
    if (p / a != b) { ret 0; }
    ret p;
}

# a+b, or 0 when the sum overflows usize
fun add_checked(a: usize, b: usize) usize {
    if (a > ~(0::usize) - b) { ret 0; }
    ret a + b;
}

# the four bytes at off compared against a chunk type
fun chunk_is(p: *u8, off: usize, a: u8, b: u8, c: u8, d: u8) u8 {
    if (p[off] != a)     { ret 0; }
    if (p[off + 1] != b) { ret 0; }
    if (p[off + 2] != c) { ret 0; }
    if (p[off + 3] != d) { ret 0; }
    ret 1;
}

# the IHDR fields the decoder needs, plus the derived sample count
# ---
# width, height: image dimensions in pixels
# depth:         bits per sample (8 or 16 once accepted)
# color_type:    PNG_COLOR_*
# interlace:     0 none, 1 Adam7
# channels:      samples per source pixel, derived from color_type
rec PngHeader {
    width:      u32;
    height:     u32;
    depth:      u8;
    color_type: u8;
    interlace:  u8;
    channels:   u8;
}

# where the chunks the decoder consumes live in the source buffer
# ---
# plte_off/plte_entries: palette offset and entry count
# trns_off/trns_len:     transparency offset and payload length in bytes
# idat_total:            summed IDAT payload bytes, the zlib stream's length
rec PngScan {
    plte_off:     usize;
    plte_entries: usize;
    trns_off:     usize;
    trns_len:     usize;
    idat_total:   usize;
    has_plte:     u8;
    has_trns:     u8;
}

# everything a single source pixel needs to become RGBA8
rec PngCtx {
    color_type:   u8;
    depth:        u8;
    has_trns:     u8;
    plte:         *u8;
    plte_entries: usize;
    trns:         *u8;
    trns_len:     usize;
}

# samples per pixel for a color type, or 0 if the color type is not defined
fun color_type_channels(color_type: u8) u8 {
    if (color_type == PNG_COLOR_GRAY)       { ret 1; }
    if (color_type == PNG_COLOR_RGB)        { ret 3; }
    if (color_type == PNG_COLOR_PALETTE)    { ret 1; }
    if (color_type == PNG_COLOR_GRAY_ALPHA) { ret 2; }
    if (color_type == PNG_COLOR_RGBA)       { ret 4; }
    ret 0;
}

# whether a bit depth is one the spec allows for a color type
fun depth_allowed(color_type: u8, depth: u8) u8 {
    if (color_type == PNG_COLOR_GRAY) {
        if (depth == 1 || depth == 2 || depth == 4 || depth == 8 || depth == 16) { ret 1; }
        ret 0;
    }
    if (color_type == PNG_COLOR_PALETTE) {
        if (depth == 1 || depth == 2 || depth == 4 || depth == 8) { ret 1; }
        ret 0;
    }
    if (depth == 8 || depth == 16) { ret 1; }
    ret 0;
}

# parse the IHDR payload at data into out
#
# separates malformed from merely unsupported: a field the spec does not define
# is DECODE_BAD_HEADER, while a valid sub-byte depth this decoder does not
# handle is DECODE_UNSUPPORTED.
fun parse_ihdr(src: *u8, data: usize, out: *PngHeader) DecodeStatus {
    val width:       u32 = read_be32(src, data);
    val height:      u32 = read_be32(src, data + 4);
    val depth:       u8  = src[data + 8];
    val color_type:  u8  = src[data + 9];
    val compression: u8  = src[data + 10];
    val filter:      u8  = src[data + 11];
    val interlace:   u8  = src[data + 12];

    if (width == 0 || height == 0)             { ret DECODE_BAD_HEADER; }
    if (width > 0x7FFFFFFF || height > 0x7FFFFFFF) { ret DECODE_BAD_HEADER; }

    val channels: u8 = color_type_channels(color_type);
    if (channels == 0)                         { ret DECODE_BAD_HEADER; }
    if (depth_allowed(color_type, depth) == 0) { ret DECODE_BAD_HEADER; }
    if (compression != 0)                      { ret DECODE_BAD_HEADER; }
    if (filter != 0)                           { ret DECODE_BAD_HEADER; }
    if (interlace != 0 && interlace != 1)      { ret DECODE_BAD_HEADER; }

    # the output buffer has to be representable before any size arithmetic runs.
    if (image_byte_len(width, height) == 0)    { ret DECODE_BAD_HEADER; }

    # sub-byte depths are well-formed PNG this decoder does not unpack.
    if (depth != 8 && depth != 16)             { ret DECODE_UNSUPPORTED; }

    out.width      = width;
    out.height     = height;
    out.depth      = depth;
    out.color_type = color_type;
    out.interlace  = interlace;
    out.channels   = channels;

    # the raster is larger than the output buffer and is the binding limit: a
    # dimension pair can be spec-legal yet overflow the scanline arithmetic.
    if (raw_byte_len(out) == 0) { ret DECODE_BAD_HEADER; }
    ret DECODE_OK;
}

# walk the whole chunk stream, validating framing and CRC
#
# doubles as a whole-file integrity check: every chunk's CRC is verified, and
# the ordering rules the decoder depends on (IHDR first, PLTE and tRNS before
# the image data, IDAT consecutive, IEND last) are enforced. ancillary chunks
# the decoder does not read are skipped.
fun scan_chunks(src: *u8, src_len: usize, hdr: *PngHeader, out: *PngScan) DecodeStatus {
    if (src == nil)         { ret DECODE_BAD_HEADER; }
    if (src_len < PNG_SIG_LEN) { ret DECODE_TRUNCATED; }

    var i: usize = 0;
    for (i < PNG_SIG_LEN) {
        if (src[i] != PNG_SIGNATURE[i]) { ret DECODE_BAD_MAGIC; }
        i = i + 1;
    }

    out.plte_off     = 0;
    out.plte_entries = 0;
    out.trns_off     = 0;
    out.trns_len     = 0;
    out.idat_total   = 0;
    out.has_plte     = 0;
    out.has_trns     = 0;

    var off:       usize = PNG_SIG_LEN;
    var seen_ihdr: u8 = 0;
    var seen_idat: u8 = 0;
    var idat_done: u8 = 0;
    var seen_iend: u8 = 0;

    for (seen_iend == 0) {
        if (off + PNG_CHUNK_OVER > src_len) { ret DECODE_TRUNCATED; }
        val raw_len: u32 = read_be32(src, off);
        if (raw_len > 0x7FFFFFFF) { ret DECODE_BAD_HEADER; }

        val dlen: usize = raw_len::usize;
        if (off + PNG_CHUNK_OVER + dlen > src_len) { ret DECODE_TRUNCATED; }

        # the CRC covers the type field and the payload, not the length.
        val want: u32 = read_be32(src, off + 8 + dlen);
        if (crc.hash(?src[off + 4], 4 + dlen) != want) { ret DECODE_CORRUPT; }

        val type_off: usize = off + 4;
        val data:     usize = off + 8;

        if (chunk_is(src, type_off, 'I', 'H', 'D', 'R') != 0) {
            if (seen_ihdr != 0)       { ret DECODE_BAD_HEADER; }
            if (off != PNG_SIG_LEN)   { ret DECODE_BAD_HEADER; }
            if (dlen != PNG_IHDR_LEN) { ret DECODE_BAD_HEADER; }
            val hs: DecodeStatus = parse_ihdr(src, data, hdr);
            if (hs != DECODE_OK) { ret hs; }
            seen_ihdr = 1;
        }
        or (seen_ihdr == 0) {
            ret DECODE_BAD_HEADER;
        }
        or (chunk_is(src, type_off, 'P', 'L', 'T', 'E') != 0) {
            if (out.has_plte != 0 || seen_idat != 0) { ret DECODE_BAD_HEADER; }
            if (dlen == 0 || dlen % 3 != 0)          { ret DECODE_BAD_HEADER; }
            # 256 is also the depth-8 index ceiling, the only depth a palette
            # reaches here: parse_ihdr has already turned 1/2/4 away.
            if (dlen / 3 > 256)                      { ret DECODE_BAD_HEADER; }
            out.plte_off     = data;
            out.plte_entries = dlen / 3;
            out.has_plte     = 1;
            idat_done        = seen_idat;
        }
        or (chunk_is(src, type_off, 't', 'R', 'N', 'S') != 0) {
            if (out.has_trns != 0 || seen_idat != 0) { ret DECODE_BAD_HEADER; }
            # tRNS carries a different payload per color type, and the spec
            # forbids it entirely where alpha is already per-pixel.
            if (hdr.color_type == PNG_COLOR_GRAY) {
                if (dlen != 2) { ret DECODE_BAD_HEADER; }
            }
            or (hdr.color_type == PNG_COLOR_RGB) {
                if (dlen != 6) { ret DECODE_BAD_HEADER; }
            }
            or (hdr.color_type == PNG_COLOR_PALETTE) {
                if (out.has_plte == 0)         { ret DECODE_BAD_HEADER; }
                if (dlen > out.plte_entries)   { ret DECODE_BAD_HEADER; }
            }
            or {
                ret DECODE_BAD_HEADER;
            }
            out.trns_off = data;
            out.trns_len = dlen;
            out.has_trns = 1;
            idat_done    = seen_idat;
        }
        or (chunk_is(src, type_off, 'I', 'D', 'A', 'T') != 0) {
            # the spec requires the IDAT run to be unbroken; a gap would mean
            # reassembling the zlib stream out of order.
            if (idat_done != 0) { ret DECODE_BAD_HEADER; }
            seen_idat      = 1;
            out.idat_total = add_checked(out.idat_total, dlen);
            if (out.idat_total == 0 && dlen != 0) { ret DECODE_BAD_HEADER; }
        }
        or (chunk_is(src, type_off, 'I', 'E', 'N', 'D') != 0) {
            if (dlen != 0)     { ret DECODE_BAD_HEADER; }
            if (seen_idat == 0) { ret DECODE_BAD_HEADER; }
            seen_iend = 1;
        }
        or {
            idat_done = seen_idat;
        }

        off = off + PNG_CHUNK_OVER + dlen;
    }

    if (hdr.color_type == PNG_COLOR_PALETTE && out.has_plte == 0) { ret DECODE_BAD_HEADER; }
    ret DECODE_OK;
}

# pixels a pass covers along one axis
fun pass_extent(size: usize, start: usize, step: usize) usize {
    if (size <= start) { ret 0; }
    ret (size - start + step - 1) / step;
}

# bytes a filtered scanline of w pixels occupies, filter byte included
#
# returns 0 when w is 0 or the length would overflow usize.
fun filtered_row_len(w: usize, channels: usize, depth: usize) usize {
    if (w == 0) { ret 0; }
    val samples: usize = mul_checked(w, channels);
    if (samples == 0) { ret 0; }
    val bytes: usize = mul_checked(samples, depth / 8);
    if (bytes == 0) { ret 0; }
    ret add_checked(bytes, 1);
}

# bytes the fully decompressed raster occupies
#
# the sum of every pass's filtered scanlines, which for a non-interlaced image
# is the single whole-image pass. returns 0 if the size is unrepresentable.
fun raw_byte_len(hdr: *PngHeader) usize {
    val channels: usize = hdr.channels::usize;
    val depth:    usize = hdr.depth::usize;
    val width:    usize = hdr.width::usize;
    val height:   usize = hdr.height::usize;

    if (hdr.interlace == 0) {
        val row: usize = filtered_row_len(width, channels, depth);
        if (row == 0) { ret 0; }
        ret mul_checked(row, height);
    }

    var total: usize = 0;
    var pass:  usize = 0;
    for (pass < 7) {
        val pw: usize = pass_extent(width, adam7_x_start[pass]::usize, adam7_x_step[pass]::usize);
        val ph: usize = pass_extent(height, adam7_y_start[pass]::usize, adam7_y_step[pass]::usize);
        if (pw != 0 && ph != 0) {
            val row: usize = filtered_row_len(pw, channels, depth);
            if (row == 0) { ret 0; }
            val bytes: usize = mul_checked(row, ph);
            if (bytes == 0) { ret 0; }
            total = add_checked(total, bytes);
            if (total == 0) { ret 0; }
        }
        pass = pass + 1;
    }
    ret total;
}

# total scratch for this image: the inflate window, the raster, and the spare
# byte that catches an over-long stream
#
# returns 0 if any step is unrepresentable, matching raw_byte_len.
fun scratch_byte_len(hdr: *PngHeader) usize {
    val raw: usize = raw_byte_len(hdr);
    if (raw == 0) { ret 0; }
    val guarded: usize = add_checked(raw, 1);
    if (guarded == 0) { ret 0; }
    ret add_checked(PNG_WINDOW_SCRATCH, guarded);
}

fun abs_i32(v: i32) i32 {
    if (v < 0) { ret -v; }
    ret v;
}

# the PNG Paeth predictor over the left, above, and above-left bytes
fun paeth(a: u8, b: u8, c: u8) u8 {
    val p:  i32 = a::i32 + b::i32 - c::i32;
    val pa: i32 = abs_i32(p - a::i32);
    val pb: i32 = abs_i32(p - b::i32);
    val pc: i32 = abs_i32(p - c::i32);
    if (pa <= pb && pa <= pc) { ret a; }
    if (pb <= pc)             { ret b; }
    ret c;
}

# reverse one scanline's filter in place
#
# cur is the scanline's data bytes (the filter byte already stripped) and prev
# the previous scanline's, or nil on the first row of a pass, where the spec
# treats the row above as all zero. bpp is the filter's byte stride, which for
# depths 8 and 16 is a whole number of bytes. all arithmetic is mod 256.
fun unfilter_row(filter: u8, cur: *u8, prev: *u8, len: usize, bpp: usize) DecodeStatus {
    var i: usize = 0;

    if (filter == 0) {
        ret DECODE_OK;
    }
    if (filter == 1) {
        i = bpp;
        for (i < len) {
            cur[i] = cur[i] + cur[i - bpp];
            i = i + 1;
        }
        ret DECODE_OK;
    }
    if (filter == 2) {
        if (prev == nil) { ret DECODE_OK; }
        for (i < len) {
            cur[i] = cur[i] + prev[i];
            i = i + 1;
        }
        ret DECODE_OK;
    }
    if (filter == 3) {
        for (i < len) {
            var a: u16 = 0;
            var b: u16 = 0;
            if (i >= bpp)    { a = cur[i - bpp]::u16; }
            if (prev != nil) { b = prev[i]::u16; }
            cur[i] = cur[i] + ((a + b) / 2)::u8;
            i = i + 1;
        }
        ret DECODE_OK;
    }
    if (filter == 4) {
        for (i < len) {
            var a: u8 = 0;
            var b: u8 = 0;
            var c: u8 = 0;
            if (i >= bpp)    { a = cur[i - bpp]; }
            if (prev != nil) {
                b = prev[i];
                if (i >= bpp) { c = prev[i - bpp]; }
            }
            cur[i] = cur[i] + paeth(a, b, c);
            i = i + 1;
        }
        ret DECODE_OK;
    }

    ret DECODE_CORRUPT;
}

# the i-th sample of a source pixel at its stored precision
fun sample_full(src: *u8, i: usize, depth: u8) u16 {
    if (depth == 16) { ret read_be16(src, i * 2); }
    ret src[i]::u16;
}

# the i-th sample reduced to 8 bits
#
# a 16-bit sample keeps its high byte, the usual truncation; mach-image does no
# colorspace work, so no rounding or gamma correction is applied.
fun sample_8(src: *u8, i: usize, depth: u8) u8 {
    if (depth == 16) { ret src[i * 2]; }
    ret src[i];
}

# expand one source pixel to RGBA8
#
# tRNS is matched against the sample at its stored precision, not the reduced
# 8-bit value, so two 16-bit samples that collapse to the same byte stay
# distinguishable.
fun emit_pixel(ctx: *PngCtx, src: *u8, dst: *u8) DecodeStatus {
    val depth: u8 = ctx.depth;

    if (ctx.color_type == PNG_COLOR_GRAY) {
        val g: u8 = sample_8(src, 0, depth);
        dst[0] = g;
        dst[1] = g;
        dst[2] = g;
        dst[3] = 255;
        if (ctx.has_trns != 0 && sample_full(src, 0, depth) == read_be16(ctx.trns, 0)) {
            dst[3] = 0;
        }
        ret DECODE_OK;
    }

    if (ctx.color_type == PNG_COLOR_RGB) {
        dst[0] = sample_8(src, 0, depth);
        dst[1] = sample_8(src, 1, depth);
        dst[2] = sample_8(src, 2, depth);
        dst[3] = 255;
        if (ctx.has_trns != 0) {
            if (sample_full(src, 0, depth) == read_be16(ctx.trns, 0)
                && sample_full(src, 1, depth) == read_be16(ctx.trns, 2)
                && sample_full(src, 2, depth) == read_be16(ctx.trns, 4)) {
                dst[3] = 0;
            }
        }
        ret DECODE_OK;
    }

    if (ctx.color_type == PNG_COLOR_PALETTE) {
        val idx: usize = src[0]::usize;
        if (idx >= ctx.plte_entries) { ret DECODE_CORRUPT; }
        val base: usize = idx * 3;
        dst[0] = ctx.plte[base];
        dst[1] = ctx.plte[base + 1];
        dst[2] = ctx.plte[base + 2];
        dst[3] = 255;
        # tRNS may cover only a prefix of the palette; the rest stays opaque.
        if (ctx.has_trns != 0 && idx < ctx.trns_len) { dst[3] = ctx.trns[idx]; }
        ret DECODE_OK;
    }

    if (ctx.color_type == PNG_COLOR_GRAY_ALPHA) {
        val g: u8 = sample_8(src, 0, depth);
        dst[0] = g;
        dst[1] = g;
        dst[2] = g;
        dst[3] = sample_8(src, 1, depth);
        ret DECODE_OK;
    }

    dst[0] = sample_8(src, 0, depth);
    dst[1] = sample_8(src, 1, depth);
    dst[2] = sample_8(src, 2, depth);
    dst[3] = sample_8(src, 3, depth);
    ret DECODE_OK;
}

# expand already-decompressed filtered scanlines into the RGBA8 destination
#
# raw holds the passes back to back, each pass a run of scanlines prefixed by a
# filter byte; defiltering happens in place, so raw is modified. a
# non-interlaced image is the single-pass case of the same walk, which is why
# there is no separate path for it. dst must already be image_byte_len bytes.
fun decode_raster(hdr: *PngHeader, ctx: *PngCtx, raw: *u8, raw_len: usize, dst: *u8) DecodeStatus {
    val width:    usize = hdr.width::usize;
    val height:   usize = hdr.height::usize;
    val channels: usize = hdr.channels::usize;
    val depth:    usize = hdr.depth::usize;
    val bpp:      usize = channels * (depth / 8);

    var pass_count: usize = 1;
    if (hdr.interlace != 0) { pass_count = 7; }

    var off:  usize = 0;
    var pass: usize = 0;
    for (pass < pass_count) {
        var x_start: usize = 0;
        var y_start: usize = 0;
        var x_step:  usize = 1;
        var y_step:  usize = 1;
        var pw:      usize = width;
        var ph:      usize = height;

        if (hdr.interlace != 0) {
            x_start = adam7_x_start[pass]::usize;
            y_start = adam7_y_start[pass]::usize;
            x_step  = adam7_x_step[pass]::usize;
            y_step  = adam7_y_step[pass]::usize;
            pw      = pass_extent(width, x_start, x_step);
            ph      = pass_extent(height, y_start, y_step);
        }

        if (pw != 0 && ph != 0) {
            val row_bytes: usize = pw * bpp;
            var prev: *u8 = nil;
            var row:  usize = 0;
            for (row < ph) {
                if (off + 1 + row_bytes > raw_len) { ret DECODE_TRUNCATED; }
                val filter: u8  = raw[off];
                val cur:    *u8 = ?raw[off + 1];

                val fs: DecodeStatus = unfilter_row(filter, cur, prev, row_bytes, bpp);
                if (fs != DECODE_OK) { ret fs; }

                val y: usize = y_start + row * y_step;
                var col: usize = 0;
                for (col < pw) {
                    val x: usize = x_start + col * x_step;
                    val es: DecodeStatus = emit_pixel(ctx, ?cur[col * bpp], ?dst[(y * width + x) * 4]);
                    if (es != DECODE_OK) { ret es; }
                    col = col + 1;
                }

                prev = cur;
                off  = off + 1 + row_bytes;
                row  = row + 1;
            }
        }
        pass = pass + 1;
    }

    ret DECODE_OK;
}

# parse a PNG header into out (dimensions and metadata only)
#
# leaves out.pixels nil. unlike the single-header formats, this walks the whole
# chunk stream: PNG reports transparency in a tRNS chunk that follows IHDR, so
# the channel count is not knowable from the header alone. that makes an info
# call a full framing and CRC check as well.
# ---
# src:     pointer to the encoded PNG bytes
# src_len: number of bytes available at src
# out:     Image to populate with width/height/channels/colorspace
# ret:     DECODE_OK, or a DECODE_* error
pub fun png_info(src: *u8, src_len: usize, out: *Image) DecodeStatus {
    if (out == nil) { ret DECODE_BAD_HEADER; }

    var hdr:  PngHeader;
    var scan: PngScan;
    val st: DecodeStatus = scan_chunks(src, src_len, ?hdr, ?scan);
    if (st != DECODE_OK) { ret st; }

    var channels: u8 = 3;
    if (hdr.color_type == PNG_COLOR_GRAY_ALPHA
        || hdr.color_type == PNG_COLOR_RGBA
        || scan.has_trns != 0) {
        channels = 4;
    }

    out.pixels     = nil;
    out.width      = hdr.width;
    out.height     = hdr.height;
    out.channels   = channels;
    out.colorspace = COLORSPACE_SRGB;
    ret DECODE_OK;
}

# scratch bytes png_decode needs for this image
#
# the scratch holds the inflate window followed by the decompressed raster, so
# the decoder allocates nothing of its own: the window is bump-allocated out of
# this buffer. the raster gets one byte more than it needs, which is what lets
# an over-long zlib stream be caught rather than silently truncated. returns 0
# when the header is unreadable or the size is unrepresentable, so a 0 result is
# never a valid scratch size.
# ---
# src:     pointer to the encoded PNG bytes
# src_len: number of bytes available at src
# ret:     required scratch size in bytes, or 0
pub fun png_scratch_len(src: *u8, src_len: usize) usize {
    var hdr:  PngHeader;
    var scan: PngScan;
    if (scan_chunks(src, src_len, ?hdr, ?scan) != DECODE_OK) { ret 0; }
    ret scratch_byte_len(?hdr);
}

# decompress the zlib stream spread across the IDAT chunks into dst
#
# the stream is one zlib member split at arbitrary points, so the chunk
# boundaries mean nothing to the decompressor and each payload is fed straight
# from the source buffer with no staging copy. std.compress.zlib owns the
# framing: it validates the two-byte header, tracks the Adler-32, and reports
# DONE only once the trailer matches, all across chunk boundaries. dst is one
# byte longer than the raster, so a stream that produces too much fills it and
# is caught rather than silently truncated.
fun inflate_idat(src: *u8, src_len: usize, z: *ZL.Decompressor, dst: *u8, dst_len: usize, raw_len: usize) DecodeStatus {
    var produced:  usize = 0;
    var off:       usize = PNG_SIG_LEN;
    var seen_iend: u8 = 0;

    for (seen_iend == 0) {
        # scan_chunks already walked this framing, but the bounds are rechecked
        # rather than assumed: nothing here should trust the source buffer.
        if (off + PNG_CHUNK_OVER > src_len) { ret DECODE_TRUNCATED; }
        val dlen: usize = read_be32(src, off)::usize;
        if (off + PNG_CHUNK_OVER + dlen > src_len) { ret DECODE_TRUNCATED; }

        val type_off: usize = off + 4;
        val data:     usize = off + 8;

        if (chunk_is(src, type_off, 'I', 'E', 'N', 'D') != 0) { seen_iend = 1; }
        or (chunk_is(src, type_off, 'I', 'D', 'A', 'T') != 0) {
            var pos: usize = 0;
            for (pos < dlen) {
                val res: R.Result[ZL.Progress, str] =
                    ZL.decompress(z, ?src[data + pos], dlen - pos, ?dst[produced], dst_len - produced);
                if (R.is_err[ZL.Progress, str](res)) { ret DECODE_CORRUPT; }

                val p: ZL.Progress = R.unwrap_ok[ZL.Progress, str](res);
                pos      = pos + p.consumed;
                produced = produced + p.written;

                # dst carries a spare byte, so filling it means the stream
                # decompresses to more than the header's dimensions allow.
                if (p.status == ZL.OUTPUT_FULL) { ret DECODE_CORRUPT; }
                # bytes trailing a finished stream are not ours to interpret.
                if (p.status == ZL.DONE)        { brk; }
                # a call that neither consumed nor produced cannot be repeated
                # to any effect; stop and let the checks below classify it.
                if (p.consumed == 0 && p.written == 0) { brk; }
            }
        }

        off = off + PNG_CHUNK_OVER + dlen;
    }

    # finish reports a stream that never reached its trailer, which is how a
    # payload cut short mid-deflate surfaces.
    if (R.is_err[bool, str](ZL.finish(z))) { ret DECODE_TRUNCATED; }
    if (produced != raw_len) { ret DECODE_CORRUPT; }
    ret DECODE_OK;
}

# decode a PNG into the caller-supplied RGBA8 buffer
#
# dst must be at least image_byte_len(width, height) bytes and scratch at least
# png_scratch_len(src, src_len); both come from the caller, so the decode
# allocates nothing and touches no OS interface. every chunk CRC and the zlib
# stream's Adler-32 are verified, so a stream that decompresses to the wrong
# length or fails its checksum is rejected rather than partially trusted.
# ---
# src:         pointer to the encoded PNG bytes
# src_len:     number of bytes available at src
# dst:         destination RGBA8 buffer
# dst_len:     size of dst in bytes
# scratch:     working buffer for the inflate window and the raster
# scratch_len: size of scratch in bytes
# out:         Image populated to describe the decoded pixels
# ret:         DECODE_OK, or a DECODE_* error
pub fun png_decode(src: *u8, src_len: usize, dst: *u8, dst_len: usize,
                   scratch: *u8, scratch_len: usize, out: *Image) DecodeStatus {
    if (out == nil) { ret DECODE_BAD_HEADER; }

    var hdr:  PngHeader;
    var scan: PngScan;
    val st: DecodeStatus = scan_chunks(src, src_len, ?hdr, ?scan);
    if (st != DECODE_OK) { ret st; }

    if (dst == nil || scratch == nil) { ret DECODE_SHORT_BUFFER; }

    val need: usize = image_byte_len(hdr.width, hdr.height);
    if (dst_len < need) { ret DECODE_SHORT_BUFFER; }

    val raw_len: usize = raw_byte_len(?hdr);
    if (raw_len == 0) { ret DECODE_BAD_HEADER; }

    val scratch_need: usize = scratch_byte_len(?hdr);
    if (scratch_need == 0)          { ret DECODE_BAD_HEADER; }
    if (scratch_len < scratch_need) { ret DECODE_SHORT_BUFFER; }

    # the inflate window is bump-allocated out of the head of the caller's
    # scratch; the raster follows it.
    var alloc: A.Allocator;
    var fixed: FIX.FixedState;
    val mk: O.Option[*u8] = FIX.make(?alloc, ?fixed, scratch, PNG_WINDOW_SCRATCH);
    if (O.is_some[*u8](mk)) { ret DECODE_SHORT_BUFFER; }

    val zres: R.Result[ZL.Decompressor, str] = ZL.init(?alloc);
    if (R.is_err[ZL.Decompressor, str](zres)) { ret DECODE_SHORT_BUFFER; }
    var z: ZL.Decompressor = R.unwrap_ok[ZL.Decompressor, str](zres);

    val raw: *u8 = ?scratch[PNG_WINDOW_SCRATCH];
    val ist: DecodeStatus = inflate_idat(src, src_len, ?z, raw, raw_len + 1, raw_len);
    ZL.dnit(?z);
    if (ist != DECODE_OK) { ret ist; }

    var ctx: PngCtx;
    ctx.color_type   = hdr.color_type;
    ctx.depth        = hdr.depth;
    ctx.has_trns     = scan.has_trns;
    ctx.plte         = nil;
    ctx.plte_entries = scan.plte_entries;
    ctx.trns         = nil;
    ctx.trns_len     = scan.trns_len;
    if (scan.has_plte != 0) { ctx.plte = ?src[scan.plte_off]; }
    if (scan.has_trns != 0) { ctx.trns = ?src[scan.trns_off]; }

    val rst: DecodeStatus = decode_raster(?hdr, ?ctx, raw, raw_len, dst);
    if (rst != DECODE_OK) { ret rst; }

    var channels: u8 = 3;
    if (hdr.color_type == PNG_COLOR_GRAY_ALPHA
        || hdr.color_type == PNG_COLOR_RGBA
        || scan.has_trns != 0) {
        channels = 4;
    }

    out.pixels     = dst;
    out.width      = hdr.width;
    out.height     = hdr.height;
    out.channels   = channels;
    out.colorspace = COLORSPACE_SRGB;
    ret DECODE_OK;
}

