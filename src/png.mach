# populate a header and context for a raster test; palette and tRNS start empty
fun test_ctx(hdr: *PngHeader, ctx: *PngCtx, w: u32, h: u32, depth: u8, ct: u8, interlace: u8) {
    hdr.width      = w;
    hdr.height     = h;
    hdr.depth      = depth;
    hdr.color_type = ct;
    hdr.interlace  = interlace;
    hdr.channels   = color_type_channels(ct);

    ctx.color_type   = ct;
    ctx.depth        = depth;
    ctx.has_trns     = 0;
    ctx.plte         = nil;
    ctx.plte_entries = 0;
    ctx.trns         = nil;
    ctx.trns_len     = 0;
}

# defilter a fixture into png_pix, leaving the fixture itself untouched
fun run_raster(hdr: *PngHeader, ctx: *PngCtx, raw: *u8, raw_len: usize) DecodeStatus {
    raw_copy(?png_raw[0], raw, raw_len);
    ret decode_raster(hdr, ctx, ?png_raw[0], raw_len, ?png_pix[0]);
}

test "png: every scanline filter reconstructs the same image" {
    var hdr: PngHeader;
    var ctx: PngCtx;
    test_ctx(?hdr, ?ctx, 4, 3, 8, PNG_COLOR_RGB, 0);

    if (run_raster(?hdr, ?ctx, ?flt0_raw[0], 39) != DECODE_OK) { ret 1; }
    if (!raw_equal(?png_pix[0], ?flt_expect[0], 48)) { ret 1; }

    if (run_raster(?hdr, ?ctx, ?flt1_raw[0], 39) != DECODE_OK) { ret 2; }
    if (!raw_equal(?png_pix[0], ?flt_expect[0], 48)) { ret 2; }

    if (run_raster(?hdr, ?ctx, ?flt2_raw[0], 39) != DECODE_OK) { ret 3; }
    if (!raw_equal(?png_pix[0], ?flt_expect[0], 48)) { ret 3; }

    if (run_raster(?hdr, ?ctx, ?flt3_raw[0], 39) != DECODE_OK) { ret 4; }
    if (!raw_equal(?png_pix[0], ?flt_expect[0], 48)) { ret 4; }

    if (run_raster(?hdr, ?ctx, ?flt4_raw[0], 39) != DECODE_OK) { ret 5; }
    if (!raw_equal(?png_pix[0], ?flt_expect[0], 48)) { ret 5; }
    ret 0;
}

test "png: adam7 and progressive forms of one image agree" {
    var hdr: PngHeader;
    var ctx: PngCtx;

    test_ctx(?hdr, ?ctx, 7, 5, 8, PNG_COLOR_RGB, 0);
    if (run_raster(?hdr, ?ctx, ?adam7_progressive_raw[0], 110) != DECODE_OK) { ret 1; }
    if (!raw_equal(?png_pix[0], ?adam7_expect[0], 140)) { ret 1; }

    test_ctx(?hdr, ?ctx, 7, 5, 8, PNG_COLOR_RGB, 1);
    if (run_raster(?hdr, ?ctx, ?adam7_interlaced_raw[0], 116) != DECODE_OK) { ret 2; }
    if (!raw_equal(?png_pix[0], ?adam7_expect[0], 140)) { ret 2; }
    ret 0;
}

test "png: 16-bit samples reduce to the high byte" {
    var hdr: PngHeader;
    var ctx: PngCtx;
    test_ctx(?hdr, ?ctx, 3, 2, 16, PNG_COLOR_RGB, 0);
    ctx.has_trns = 1;
    ctx.trns     = ?rgb16_trns[0];
    ctx.trns_len = 6;

    if (run_raster(?hdr, ?ctx, ?rgb16_raw[0], 38) != DECODE_OK) { ret 1; }
    if (!raw_equal(?png_pix[0], ?rgb16_expect[0], 24)) { ret 1; }
    ret 0;
}

test "png: palette expands through a partial tRNS" {
    var hdr: PngHeader;
    var ctx: PngCtx;
    test_ctx(?hdr, ?ctx, 4, 2, 8, PNG_COLOR_PALETTE, 0);
    ctx.plte         = ?pal8_plte[0];
    ctx.plte_entries = 4;
    ctx.has_trns     = 1;
    ctx.trns         = ?pal8_trns[0];
    ctx.trns_len     = 2;

    if (run_raster(?hdr, ?ctx, ?pal8_raw[0], 10) != DECODE_OK) { ret 1; }
    if (!raw_equal(?png_pix[0], ?pal8_expect[0], 32)) { ret 1; }
    ret 0;
}

test "png: gray+alpha carries its alpha channel" {
    var hdr: PngHeader;
    var ctx: PngCtx;
    test_ctx(?hdr, ?ctx, 4, 2, 8, PNG_COLOR_GRAY_ALPHA, 0);

    if (run_raster(?hdr, ?ctx, ?ga8_raw[0], 18) != DECODE_OK) { ret 1; }
    if (!raw_equal(?png_pix[0], ?ga8_expect[0], 32)) { ret 1; }
    ret 0;
}

test "png: raster rejects a short raw buffer" {
    var hdr: PngHeader;
    var ctx: PngCtx;
    test_ctx(?hdr, ?ctx, 4, 3, 8, PNG_COLOR_RGB, 0);
    # one scanline short of the three the header declares
    if (run_raster(?hdr, ?ctx, ?flt0_raw[0], 26) != DECODE_TRUNCATED) { ret 1; }
    ret 0;
}

test "png: raster rejects an undefined filter type" {
    var hdr: PngHeader;
    var ctx: PngCtx;
    test_ctx(?hdr, ?ctx, 4, 3, 8, PNG_COLOR_RGB, 0);

    raw_copy(?png_raw[0], ?flt0_raw[0], 39);
    png_raw[0] = 5;   # only 0-4 are defined
    if (decode_raster(?hdr, ?ctx, ?png_raw[0], 39, ?png_pix[0]) != DECODE_CORRUPT) { ret 1; }
    ret 0;
}

test "png: raster rejects a palette index past the palette" {
    var hdr: PngHeader;
    var ctx: PngCtx;
    test_ctx(?hdr, ?ctx, 4, 2, 8, PNG_COLOR_PALETTE, 0);
    ctx.plte         = ?pal8_plte[0];
    ctx.plte_entries = 2;   # the fixture indexes entries 0-3

    if (run_raster(?hdr, ?ctx, ?pal8_raw[0], 10) != DECODE_CORRUPT) { ret 1; }
    ret 0;
}

test "png: info reads a well-formed header" {
    var img: Image;
    if (png_info(?file_ok[0], 84, ?img) != DECODE_OK) { ret 1; }
    if (img.width != 4 || img.height != 2) { ret 1; }
    if (img.channels != 3) { ret 1; }
    if (img.pixels != nil) { ret 1; }
    ret 0;
}

test "png: info rejects a bad signature" {
    var img: Image;
    raw_copy(?png_raw[0], ?file_ok[0], 84);
    png_raw[1] = 'X';
    if (png_info(?png_raw[0], 84, ?img) != DECODE_BAD_MAGIC) { ret 1; }
    ret 0;
}

test "png: info rejects a bad chunk crc" {
    var img: Image;
    if (png_info(?file_bad_crc[0], 84, ?img) != DECODE_CORRUPT) { ret 1; }
    ret 0;
}

test "png: info rejects a truncated stream" {
    var img: Image;
    if (png_info(?file_ok[0], 40, ?img) != DECODE_TRUNCATED) { ret 1; }
    if (png_info(?file_ok[0], 4, ?img) != DECODE_TRUNCATED)  { ret 1; }
    ret 0;
}

test "png: info reports sub-byte depths as unsupported, not malformed" {
    var img: Image;
    if (png_info(?file_gray1[0], 69, ?img) != DECODE_UNSUPPORTED) { ret 1; }
    ret 0;
}

test "png: info rejects undefined header fields" {
    var img: Image;
    if (png_info(?file_colortype1[0], 66, ?img) != DECODE_BAD_HEADER) { ret 1; }
    if (png_info(?file_depth3[0], 66, ?img) != DECODE_BAD_HEADER)     { ret 1; }
    if (png_info(?file_zerodim[0], 66, ?img) != DECODE_BAD_HEADER)    { ret 1; }
    ret 0;
}

test "png: info rejects dimensions whose raster overflows" {
    var img: Image;
    if (png_info(?file_huge[0], 66, ?img) != DECODE_BAD_HEADER) { ret 1; }
    if (png_scratch_len(?file_huge[0], 66) != 0) { ret 1; }
    ret 0;
}

test "png: info enforces the chunk ordering rules" {
    var img: Image;
    if (png_info(?file_no_idat[0], 45, ?img) != DECODE_BAD_HEADER)      { ret 1; }
    if (png_info(?file_idat_bad_crc[0], 84, ?img) != DECODE_CORRUPT)    { ret 2; }
    if (png_info(?file_split_idat[0], 111, ?img) != DECODE_BAD_HEADER)  { ret 3; }
    # the same two chunks are fine when nothing breaks the run
    if (png_info(?file_two_idat[0], 96, ?img) != DECODE_OK)             { ret 4; }
    ret 0;
}

test "png: scratch_len covers the window and the raster" {
    # 4x2 RGB8 filters to 2 * (1 + 12) = 26 raster bytes, plus the spare byte
    # that catches an over-long stream, on top of the inflate window.
    if (png_scratch_len(?file_ok[0], 84) != PNG_WINDOW_SCRATCH + 27) { ret 1; }
    if (png_scratch_len(?file_two_idat[0], 96) != PNG_WINDOW_SCRATCH + 27) { ret 2; }
    if (png_scratch_len(?file_bad_crc[0], 84) != 0) { ret 3; }
    ret 0;
}

test "png: decode a whole file end to end" {
    var img: Image;
    val scratch_need: usize = png_scratch_len(?file_ok[0], 84);
    if (scratch_need == 0 || scratch_need > 33280) { ret 1; }

    if (png_decode(?file_ok[0], 84, ?png_pix[0], 256, ?png_work[0], 33280, ?img) != DECODE_OK) { ret 2; }
    if (img.width != 4 || img.height != 2 || img.channels != 3) { ret 3; }
    if (img.pixels != ?png_pix[0]) { ret 4; }

    # the file stores 1..24 as two RGB8 scanlines, so every pixel is opaque
    var i: usize = 0;
    for (i < 8) {
        if (png_pix[i * 4]     != (i * 3 + 1)::u8) { ret 5; }
        if (png_pix[i * 4 + 1] != (i * 3 + 2)::u8) { ret 5; }
        if (png_pix[i * 4 + 2] != (i * 3 + 3)::u8) { ret 5; }
        if (png_pix[i * 4 + 3] != 255)             { ret 5; }
        i = i + 1;
    }
    ret 0;
}

test "png: decode reassembles a zlib stream split across IDAT chunks" {
    var img: Image;
    if (png_decode(?file_two_idat[0], 96, ?png_pix[0], 256, ?png_work[0], 33280, ?img) != DECODE_OK) { ret 1; }
    var i: usize = 0;
    for (i < 8) {
        if (png_pix[i * 4] != (i * 3 + 1)::u8) { ret 2; }
        i = i + 1;
    }
    ret 0;
}

test "png: decode rejects short destination and scratch" {
    var img: Image;
    if (png_decode(?file_ok[0], 84, ?png_pix[0], 4, ?png_work[0], 33280, ?img) != DECODE_SHORT_BUFFER) { ret 1; }
    if (png_decode(?file_ok[0], 84, ?png_pix[0], 256, ?png_work[0], 64, ?img) != DECODE_SHORT_BUFFER)  { ret 2; }
    if (png_decode(?file_ok[0], 84, nil, 256, ?png_work[0], 33280, ?img) != DECODE_SHORT_BUFFER)       { ret 3; }
    ret 0;
}

test "png: decode rejects a corrupted zlib stream" {
    var img: Image;
    # flip a byte inside the IDAT payload, leaving the chunk CRC to catch it
    raw_copy(?png_raw[0], ?file_ok[0], 84);
    png_raw[45] = png_raw[45] ^ 0xFF;
    if (png_decode(?png_raw[0], 84, ?png_pix[0], 256, ?png_work[0], 33280, ?img) != DECODE_CORRUPT) { ret 1; }
    ret 0;
}

test "png: decode rejects an incomplete zlib stream" {
    # the chunk framing is intact here, so the truncation is only visible once
    # the deflate stream ends without reaching its final block
    var img: Image;
    if (png_decode(?file_short_zlib[0], 76, ?png_pix[0], 256, ?png_work[0], 33280, ?img) != DECODE_TRUNCATED) { ret 1; }
    ret 0;
}

test "png: decode rejects a bad adler-32 trailer" {
    var img: Image;
    if (png_decode(?file_bad_adler[0], 84, ?png_pix[0], 256, ?png_work[0], 33280, ?img) != DECODE_CORRUPT) { ret 1; }
    ret 0;
}

test "png: chunk crc matches known values" {
    var ihdr: [4]u8 = [4]u8{'I', 'H', 'D', 'R'};
    if (crc.hash(?ihdr[0], 4) != 0xA8A1AE0A) { ret 1; }
    var iend: [4]u8 = [4]u8{'I', 'E', 'N', 'D'};
    if (crc.hash(?iend[0], 4) != 0xAE426082) { ret 1; }
    ret 0;
}

test "png: adam7 pass extents cover every pixel" {
    # the seven passes partition the image, so their areas must sum to w*h.
    var w: usize = 1;
    for (w <= 16) {
        var h: usize = 1;
        for (h <= 16) {
            var total: usize = 0;
            var p: usize = 0;
            for (p < 7) {
                total = total + pass_extent(w, adam7_x_start[p]::usize, adam7_x_step[p]::usize)
                              * pass_extent(h, adam7_y_start[p]::usize, adam7_y_step[p]::usize);
                p = p + 1;
            }
            if (total != w * h) { ret 1; }
            h = h + 1;
        }
        w = w + 1;
    }
    ret 0;
}
