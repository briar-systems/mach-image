# whether an outcome succeeded
fun passed(r: err[DecodeError]) u8 {
    if (sel r.ok) { ret 1; }
    ret 0;
}

# whether a step was refused with the case want names
fun step_refused(r: err[DecodeError], want: DecodeError) u8 {
    if (!sel r.err)                           { ret 0; }
    if (!same_case[DecodeError](r.err, want)) { ret 0; }
    ret 1;
}

# whether a decode was refused with the case want names
fun refused[T](r: res[T, DecodeError], want: DecodeError) u8 {
    if (!sel r.err)                           { ret 0; }
    if (!same_case[DecodeError](r.err, want)) { ret 0; }
    ret 1;
}

# whether a decode succeeded
fun decoded[T](r: res[T, DecodeError]) u8 {
    if (sel r.ok) { ret 1; }
    ret 0;
}

# populate a header and context for a raster test; palette and tRNS start empty
fun test_ctx(hdr: *PngHeader, ctx: *PngCtx, w: u32, h: u32, depth: u8, ct: u8, interlace: u8) {
    hdr.width      = w;
    hdr.height     = h;
    hdr.depth      = depth;
    hdr.color_type = ct;
    hdr.interlace  = interlace;
    hdr.channels   = 0;
    val channels: opt[u8] = color_type_channels(ct);
    if (sel channels.some) { hdr.channels = channels.some; }

    ctx.color_type   = ct;
    ctx.depth        = depth;
    ctx.has_trns     = 0;
    ctx.plte         = nil;
    ctx.plte_entries = 0;
    ctx.trns         = nil;
    ctx.trns_len     = 0;
}

# defilter a fixture into png_pix, leaving the fixture itself untouched
fun run_raster(hdr: *PngHeader, ctx: *PngCtx, raw: *u8, raw_len: usize) err[DecodeError] {
    raw_copy(?png_raw[0], raw, raw_len);
    ret decode_raster(hdr, ctx, ?png_raw[0], raw_len, ?png_pix[0]);
}

test "png: every scanline filter reconstructs the same image" {
    var hdr: PngHeader;
    var ctx: PngCtx;
    test_ctx(?hdr, ?ctx, 4, 3, 8, PNG_COLOR_RGB, 0);

    if (passed(run_raster(?hdr, ?ctx, ?flt0_raw[0], 39)) == 0) { ret 1; }
    if (!raw_equal(?png_pix[0], ?flt_expect[0], 48))           { ret 1; }

    if (passed(run_raster(?hdr, ?ctx, ?flt1_raw[0], 39)) == 0) { ret 2; }
    if (!raw_equal(?png_pix[0], ?flt_expect[0], 48))           { ret 2; }

    if (passed(run_raster(?hdr, ?ctx, ?flt2_raw[0], 39)) == 0) { ret 3; }
    if (!raw_equal(?png_pix[0], ?flt_expect[0], 48))           { ret 3; }

    if (passed(run_raster(?hdr, ?ctx, ?flt3_raw[0], 39)) == 0) { ret 4; }
    if (!raw_equal(?png_pix[0], ?flt_expect[0], 48))           { ret 4; }

    if (passed(run_raster(?hdr, ?ctx, ?flt4_raw[0], 39)) == 0) { ret 5; }
    if (!raw_equal(?png_pix[0], ?flt_expect[0], 48))           { ret 5; }
    ret 0;
}

test "png: adam7 and progressive forms of one image agree" {
    var hdr: PngHeader;
    var ctx: PngCtx;

    test_ctx(?hdr, ?ctx, 7, 5, 8, PNG_COLOR_RGB, 0);
    if (passed(run_raster(?hdr, ?ctx, ?adam7_progressive_raw[0], 110)) == 0) { ret 1; }
    if (!raw_equal(?png_pix[0], ?adam7_expect[0], 140))                      { ret 1; }

    test_ctx(?hdr, ?ctx, 7, 5, 8, PNG_COLOR_RGB, 1);
    if (passed(run_raster(?hdr, ?ctx, ?adam7_interlaced_raw[0], 116)) == 0) { ret 2; }
    if (!raw_equal(?png_pix[0], ?adam7_expect[0], 140))                     { ret 2; }
    ret 0;
}

test "png: 16-bit samples reduce to the high byte" {
    var hdr: PngHeader;
    var ctx: PngCtx;
    test_ctx(?hdr, ?ctx, 3, 2, 16, PNG_COLOR_RGB, 0);
    ctx.has_trns = 1;
    ctx.trns     = ?rgb16_trns[0];
    ctx.trns_len = 6;

    if (passed(run_raster(?hdr, ?ctx, ?rgb16_raw[0], 38)) == 0) { ret 1; }
    if (!raw_equal(?png_pix[0], ?rgb16_expect[0], 24))          { ret 1; }
    ret 0;
}

test "png: palette expands through a partial tRNS" {
    var hdr: PngHeader;
    var ctx: PngCtx;
    test_ctx(?hdr, ?ctx, 4, 2, 8, PNG_COLOR_PALETTE, 0);
    ctx.plte         = ?pal8_plte[0];
    ctx.plte_entries = 4;
    ctx.has_trns     = 1;
    ctx.trns         = ?pal8_trns[0];
    ctx.trns_len     = 2;

    if (passed(run_raster(?hdr, ?ctx, ?pal8_raw[0], 10)) == 0) { ret 1; }
    if (!raw_equal(?png_pix[0], ?pal8_expect[0], 32))          { ret 1; }
    ret 0;
}

test "png: sub-byte grayscale unpacks and scales stored samples" {
    var hdr: PngHeader;
    var ctx: PngCtx;

    test_ctx(?hdr, ?ctx, 5, 1, 1, PNG_COLOR_GRAY, 0);
    if (passed(run_raster(?hdr, ?ctx, ?gray1_raw[0], 2)) == 0) { ret 1; }
    if (!raw_equal(?png_pix[0], ?gray1_expect[0], 20))         { ret 1; }

    test_ctx(?hdr, ?ctx, 5, 1, 2, PNG_COLOR_GRAY, 0);
    if (passed(run_raster(?hdr, ?ctx, ?gray2_raw[0], 3)) == 0) { ret 2; }
    if (!raw_equal(?png_pix[0], ?gray2_expect[0], 20))         { ret 2; }

    test_ctx(?hdr, ?ctx, 3, 1, 4, PNG_COLOR_GRAY, 0);
    ctx.has_trns = 1;
    ctx.trns     = ?gray4_trns[0];
    ctx.trns_len = 2;
    if (passed(run_raster(?hdr, ?ctx, ?gray4_raw[0], 3)) == 0) { ret 3; }
    if (!raw_equal(?png_pix[0], ?gray4_expect[0], 12))         { ret 3; }
    ret 0;
}

test "png: sub-byte palette uses row padding and partial tRNS" {
    var hdr: PngHeader;
    var ctx: PngCtx;
    test_ctx(?hdr, ?ctx, 5, 1, 2, PNG_COLOR_PALETTE, 0);
    ctx.plte         = ?pal8_plte[0];
    ctx.plte_entries = 4;
    ctx.has_trns     = 1;
    ctx.trns         = ?pal8_trns[0];
    ctx.trns_len     = 2;

    if (passed(run_raster(?hdr, ?ctx, ?pal2_raw[0], 3)) == 0) { ret 1; }
    if (!raw_equal(?png_pix[0], ?pal2_expect[0], 20))         { ret 1; }
    ret 0;
}

test "png: gray+alpha carries its alpha channel" {
    var hdr: PngHeader;
    var ctx: PngCtx;
    test_ctx(?hdr, ?ctx, 4, 2, 8, PNG_COLOR_GRAY_ALPHA, 0);

    if (passed(run_raster(?hdr, ?ctx, ?ga8_raw[0], 18)) == 0) { ret 1; }
    if (!raw_equal(?png_pix[0], ?ga8_expect[0], 32))          { ret 1; }
    ret 0;
}

test "png: raster rejects a short raw buffer" {
    var hdr: PngHeader;
    var ctx: PngCtx;
    test_ctx(?hdr, ?ctx, 4, 3, 8, PNG_COLOR_RGB, 0);
    # one scanline short of the three the header declares
    if (step_refused(run_raster(?hdr, ?ctx, ?flt0_raw[0], 26), DecodeError.truncated{}) == 0) { ret 1; }
    ret 0;
}

test "png: raster rejects an undefined filter type" {
    var hdr: PngHeader;
    var ctx: PngCtx;
    test_ctx(?hdr, ?ctx, 4, 3, 8, PNG_COLOR_RGB, 0);

    raw_copy(?png_raw[0], ?flt0_raw[0], 39);
    png_raw[0] = 5; # only 0-4 are defined
    if (step_refused(decode_raster(?hdr, ?ctx, ?png_raw[0], 39, ?png_pix[0]), DecodeError.corrupt{}) == 0) { ret 1; }
    ret 0;
}

test "png: raster rejects a palette index past the palette" {
    var hdr: PngHeader;
    var ctx: PngCtx;
    test_ctx(?hdr, ?ctx, 4, 2, 8, PNG_COLOR_PALETTE, 0);
    ctx.plte         = ?pal8_plte[0];
    ctx.plte_entries = 2; # the fixture indexes entries 0-3

    if (step_refused(run_raster(?hdr, ?ctx, ?pal8_raw[0], 10), DecodeError.corrupt{}) == 0) { ret 1; }
    ret 0;
}

test "png: info reads a well-formed header" {
    val r: res[Image, DecodeError] = png_info(?file_ok[0], 84);
    if (!sel r.ok) { ret 1; }
    val img: Image = r.ok;
    if (img.width != 4 || img.height != 2) { ret 1; }
    if (img.channels != 3)                 { ret 1; }
    if (img.pixels != nil)                 { ret 1; }
    ret 0;
}

test "png: info rejects a bad signature" {
    raw_copy(?png_raw[0], ?file_ok[0], 84);
    png_raw[1] = 'X';
    if (refused[Image](png_info(?png_raw[0], 84), DecodeError.bad_magic{}) == 0) { ret 1; }
    ret 0;
}

test "png: info rejects a bad chunk crc" {
    if (refused[Image](png_info(?file_bad_crc[0], 84), DecodeError.corrupt{}) == 0) { ret 1; }
    ret 0;
}

test "png: unknown chunks honor the critical bit" {
    if (refused[Image](png_info(?file_unknown_critical[0], 79), DecodeError.unsupported{}) == 0)        { ret 1; }
    if (refused[usize](png_scratch_len(?file_unknown_critical[0], 79), DecodeError.unsupported{}) == 0) { ret 2; }
    if (decoded[Image](png_info(?file_unknown_ancillary[0], 79)) == 0)                                  { ret 3; }
    if (decoded[Image](png_decode(?file_unknown_ancillary[0], 79, ?png_pix[0], 256,
        ?png_work[0], 33280)) == 0) { ret 4; }
    if (png_pix[0] != 42 || png_pix[1] != 42 || png_pix[2] != 42 || png_pix[3] != 255)            { ret 5; }
    if (refused[Image](png_info(?file_invalid_chunk_type[0], 79), DecodeError.bad_header{}) == 0) { ret 6; }
    ret 0;
}

test "png: info enforces PLTE placement and color types" {
    if (refused[Image](png_info(?file_gray_plte[0], 82), DecodeError.bad_header{}) == 0)         { ret 1; }
    if (refused[Image](png_info(?file_trns_before_plte[0], 102), DecodeError.bad_header{}) == 0) { ret 2; }
    ret 0;
}

test "png: tRNS masks bits above the image depth" {
    val r: res[Image, DecodeError] = png_decode(?file_trns_mask[0], 81, ?png_pix[0], 256, ?png_work[0], 33280);
    if (!sel r.ok)                                                                   { ret 1; }
    if (r.ok.channels != 4)                                                          { ret 2; }
    if (png_pix[0] != 42 || png_pix[1] != 42 || png_pix[2] != 42 || png_pix[3] != 0) { ret 3; }

    if (decoded[Image](png_decode(?file_rgb_trns_mask[0], 87, ?png_pix[0], 256,
        ?png_work[0], 33280)) == 0) { ret 4; }
    if (png_pix[0] != 1 || png_pix[1] != 2 || png_pix[2] != 3 || png_pix[3] != 0) { ret 5; }
    ret 0;
}

test "png: info rejects a truncated stream" {
    if (refused[Image](png_info(?file_ok[0], 40), DecodeError.truncated{}) == 0) { ret 1; }
    if (refused[Image](png_info(?file_ok[0], 4), DecodeError.truncated{}) == 0)  { ret 1; }
    ret 0;
}

test "png: sub-byte grayscale decodes through the public API" {
    val info: res[Image, DecodeError] = png_info(?file_gray1[0], 69);
    if (!sel info.ok)                                                       { ret 1; }
    if (info.ok.width != 4 || info.ok.height != 2 || info.ok.channels != 3) { ret 2; }
    if (decoded[Image](png_decode(?file_gray1[0], 69, ?png_pix[0], 256,
        ?png_work[0], 33280)) == 0) { ret 3; }
    if (png_pix[0] != 255 || png_pix[4] != 0 || png_pix[8] != 255 || png_pix[12] != 255) { ret 4; }
    if (png_pix[16] != 0 || png_pix[20] != 255 || png_pix[24] != 0 || png_pix[28] != 0)  { ret 5; }
    ret 0;
}

test "png: info rejects undefined header fields" {
    if (refused[Image](png_info(?file_colortype1[0], 66), DecodeError.bad_header{}) == 0) { ret 1; }
    if (refused[Image](png_info(?file_depth3[0], 66), DecodeError.bad_header{}) == 0)     { ret 1; }
    if (refused[Image](png_info(?file_zerodim[0], 66), DecodeError.bad_header{}) == 0)    { ret 1; }
    ret 0;
}

test "png: info rejects dimensions whose raster overflows" {
    if (refused[Image](png_info(?file_huge[0], 66), DecodeError.bad_header{}) == 0)        { ret 1; }
    if (refused[usize](png_scratch_len(?file_huge[0], 66), DecodeError.bad_header{}) == 0) { ret 2; }
    ret 0;
}

test "png: info enforces the chunk ordering rules" {
    if (refused[Image](png_info(?file_no_idat[0], 45), DecodeError.bad_header{}) == 0)     { ret 1; }
    if (refused[Image](png_info(?file_idat_bad_crc[0], 84), DecodeError.corrupt{}) == 0)   { ret 2; }
    if (refused[Image](png_info(?file_split_idat[0], 111), DecodeError.bad_header{}) == 0) { ret 3; }
    # the same two chunks are fine when nothing breaks the run
    if (decoded[Image](png_info(?file_two_idat[0], 96)) == 0) { ret 4; }
    ret 0;
}

test "png: scratch_len covers the window and the raster" {
    # 4x2 RGB8 filters to 2 * (1 + 12) = 26 raster bytes, plus the spare byte
    # that catches an over-long stream, on top of the inflate window.
    val ok: res[usize, DecodeError] = png_scratch_len(?file_ok[0], 84);
    if (!sel ok.ok)                       { ret 1; }
    if (ok.ok != PNG_WINDOW_SCRATCH + 27) { ret 1; }
    val two: res[usize, DecodeError] = png_scratch_len(?file_two_idat[0], 96);
    if (!sel two.ok)                                                                       { ret 2; }
    if (two.ok != PNG_WINDOW_SCRATCH + 27)                                                 { ret 2; }
    if (refused[usize](png_scratch_len(?file_bad_crc[0], 84), DecodeError.corrupt{}) == 0) { ret 3; }
    ret 0;
}

test "png: decode a whole file end to end" {
    val scratch_need: res[usize, DecodeError] = png_scratch_len(?file_ok[0], 84);
    if (!sel scratch_need.ok)    { ret 1; }
    if (scratch_need.ok > 33280) { ret 1; }

    val r: res[Image, DecodeError] = png_decode(?file_ok[0], 84, ?png_pix[0], 256, ?png_work[0], 33280);
    if (!sel r.ok) { ret 2; }
    val img: Image = r.ok;
    if (img.width != 4 || img.height != 2 || img.channels != 3) { ret 3; }
    if (img.pixels != ?png_pix[0])                              { ret 4; }

    # the file stores 1..24 as two RGB8 scanlines, so every pixel is opaque
    var i: usize = 0;
    for (i < 8) {
        if (png_pix[i * 4] != (i * 3 + 1)::u8)     { ret 5; }
        if (png_pix[i * 4 + 1] != (i * 3 + 2)::u8) { ret 5; }
        if (png_pix[i * 4 + 2] != (i * 3 + 3)::u8) { ret 5; }
        if (png_pix[i * 4 + 3] != 255)             { ret 5; }
        i = i + 1;
    }
    ret 0;
}

test "png: decode reassembles a zlib stream split across IDAT chunks" {
    if (decoded[Image](png_decode(?file_two_idat[0], 96, ?png_pix[0], 256, ?png_work[0], 33280)) == 0) { ret 1; }
    var i: usize = 0;
    for (i < 8) {
        if (png_pix[i * 4] != (i * 3 + 1)::u8) { ret 2; }
        i = i + 1;
    }
    ret 0;
}

test "png: decode ignores unused trailing IDAT bytes" {
    if (decoded[Image](png_decode(?file_trailing_in_idat[0], 70, ?png_pix[0], 256,
        ?png_work[0], 33280)) == 0) { ret 1; }
    if (png_pix[0] != 42 || png_pix[1] != 42 || png_pix[2] != 42 || png_pix[3] != 255) { ret 2; }

    if (decoded[Image](png_decode(?file_trailing_idat[0], 82, ?png_pix[0], 256,
        ?png_work[0], 33280)) == 0) { ret 3; }
    if (png_pix[0] != 42 || png_pix[1] != 42 || png_pix[2] != 42 || png_pix[3] != 255) { ret 4; }
    ret 0;
}

test "png: decode rejects short destination and scratch" {
    val dst: res[Image, DecodeError] = png_decode(?file_ok[0], 84, ?png_pix[0], 4, ?png_work[0], 33280);
    if (!sel dst.err)               { ret 1; }
    if (!sel dst.err.short_buffer)  { ret 1; }
    if (dst.err.short_buffer != 32) { ret 1; }

    # png_scratch_len is exact, not a lower bound: one byte less must be refused
    # and exactly that many must succeed.
    val need: res[usize, DecodeError] = png_scratch_len(?file_ok[0], 84);
    if (!sel need.ok)    { ret 2; }
    if (need.ok > 33280) { ret 2; }

    val scratch: res[Image, DecodeError] = png_decode(?file_ok[0], 84, ?png_pix[0], 256, ?png_work[0], 64);
    if (!sel scratch.err)                     { ret 3; }
    if (!sel scratch.err.short_scratch)       { ret 3; }
    if (scratch.err.short_scratch != need.ok) { ret 3; }

    if (refused[Image](png_decode(?file_ok[0], 84, ?png_pix[0], 256, ?png_work[0], need.ok - 1),
        DecodeError.short_scratch{0}) == 0) { ret 4; }
    if (decoded[Image](png_decode(?file_ok[0], 84, ?png_pix[0], 256, ?png_work[0], need.ok)) == 0) { ret 5; }
    ret 0;
}

test "png: decode rejects a corrupted zlib stream" {
    # flip a byte inside the IDAT payload, leaving the chunk CRC to catch it
    raw_copy(?png_raw[0], ?file_ok[0], 84);
    png_raw[45] = png_raw[45] ^ 0xFF;
    if (refused[Image](png_decode(?png_raw[0], 84, ?png_pix[0], 256, ?png_work[0], 33280), DecodeError.corrupt{}) == 0) { ret 1; }
    ret 0;
}

test "png: decode rejects an incomplete zlib stream" {
    # the chunk framing is intact here, so the truncation is only visible once
    # the deflate stream ends without reaching its final block
    if (refused[Image](png_decode(?file_short_zlib[0], 76, ?png_pix[0], 256, ?png_work[0], 33280), DecodeError.truncated{}) == 0) { ret 1; }
    ret 0;
}

test "png: decode rejects a bad adler-32 trailer" {
    if (refused[Image](png_decode(?file_bad_adler[0], 84, ?png_pix[0], 256, ?png_work[0], 33280), DecodeError.corrupt{}) == 0) { ret 1; }
    ret 0;
}

test "png: chunk crc matches known values" {
    var ihdr: [4]u8 = [4]u8{'I', 'H', 'D', 'R'};
    if (crc.hash(?ihdr[0], 4) != 0xA8A1AE0A) { ret 1; }
    var iend: [4]u8 = [4]u8{'I', 'E', 'N', 'D'};
    if (crc.hash(?iend[0], 4) != 0xAE426082) { ret 1; }
    ret 0;
}

test "png: adam7 pass extents cover every pixel" {
    # the seven passes partition the image, so their areas must sum to w*h.
    var w: usize = 1;
    for (w <= 16) {
        var h: usize = 1;
        for (h <= 16) {
            var total: usize = 0;
            var p:     usize = 0;
            for (p < 7) {
                total = total + pass_extent(w, adam7_x_start[p]::usize, adam7_x_step[p]::usize)
                    * pass_extent(h, adam7_y_start[p]::usize, adam7_y_step[p]::usize);
                p = p + 1;
            }
            if (total != w * h) { ret 1; }
            h = h + 1;
        }
        w = w + 1;
    }
    ret 0;
}

test "png: encode matches an independently decoded golden" {
    png_enc_src[0] = 0x12;
    png_enc_src[1] = 0x34;
    png_enc_src[2] = 0x56;
    png_enc_src[3] = 0x78;

    var src: Image;
    src.pixels     = ?png_enc_src[0];
    src.width      = 1;
    src.height     = 1;
    src.channels   = 4;
    src.colorspace = COLORSPACE_SRGB;

    val bound: res[usize, EncodeError] = png_encode_bound(1, 1);
    if (!sel bound.ok)  { ret 1; }
    if (bound.ok != 73) { ret 1; }
    val enc: res[usize, EncodeError] = png_encode(?src, ?png_enc[0], 4096);
    if (!sel enc.ok)                                     { ret 2; }
    if (enc.ok != 73)                                    { ret 2; }
    if (!raw_equal(?png_enc[0], ?png_enc_golden[0], 73)) { ret 3; }

    # the exact file also pins chunk layout, CRCs, zlib framing, and Adler-32.
    if (read_be32(?png_enc[0], 8) != 13 || read_be32(?png_enc[0], 33) != 16) { ret 4; }
    if (crc.hash(?png_enc[12], 17) != read_be32(?png_enc[0], 29))            { ret 5; }
    if (crc.hash(?png_enc[37], 20) != read_be32(?png_enc[0], 57))            { ret 6; }
    if (png_enc[41] != 0x78 || png_enc[42] != 0x01)                          { ret 7; }
    if (read_be32(?png_enc[0], 53) != 0x020D0115)                            { ret 8; }
    if (crc.hash(?png_enc[65], 4) != read_be32(?png_enc[0], 69))             { ret 9; }
    ret 0;
}

test "png: encode then decode round-trips RGBA8" {
    val w:     u32   = 8;
    val h:     u32   = 8;
    val bytes: usize = w::usize * h::usize * 4;
    var i:     usize = 0;
    for (i < bytes) {
        png_enc_src[i] = (i * 37 + i / 4 * 11)::u8;
        i              = i + 1;
    }

    var src: Image;
    src.pixels     = ?png_enc_src[0];
    src.width      = w;
    src.height     = h;
    src.channels   = 4;
    src.colorspace = COLORSPACE_LINEAR;

    val bound: res[usize, EncodeError] = png_encode_bound(w, h);
    if (!sel bound.ok)   { ret 1; }
    if (bound.ok > 4096) { ret 1; }
    val enc: res[usize, EncodeError] = png_encode(?src, ?png_enc[0], 4096);
    if (!sel enc.ok)        { ret 2; }
    if (enc.ok != bound.ok) { ret 2; }
    val n: usize = enc.ok;

    val r: res[Image, DecodeError] = png_info(?png_enc[0], n);
    if (!sel r.ok) { ret 3; }
    val info: Image = r.ok;
    if (info.width != w || info.height != h || info.channels != 4
        || info.colorspace != COLORSPACE_SRGB) { ret 4; }

    val scratch: res[usize, DecodeError] = png_scratch_len(?png_enc[0], n);
    if (!sel scratch.ok)    { ret 5; }
    if (scratch.ok > 33280) { ret 5; }
    if (decoded[Image](png_decode(?png_enc[0], n, ?png_enc_rt[0], 256,
        ?png_work[0], scratch.ok)) == 0) { ret 6; }
    if (!raw_equal(?png_enc_src[0], ?png_enc_rt[0], bytes)) { ret 7; }
    ret 0;
}

test "png: encode rejects invalid input and short buffers without writing" {
    png_enc_src[0] = 1;
    png_enc_src[1] = 2;
    png_enc_src[2] = 3;
    png_enc_src[3] = 4;

    var src: Image;
    src.pixels     = ?png_enc_src[0];
    src.width      = 1;
    src.height     = 1;
    src.channels   = 4;
    src.colorspace = COLORSPACE_SRGB;

    var i: usize = 0;
    for (i < 73) {
        png_enc[i] = 0xA5;
        i          = i + 1;
    }
    val short: res[usize, EncodeError] = png_encode(?src, ?png_enc[0], 72);
    if (!sel short.err)               { ret 1; }
    if (!sel short.err.short_buffer)  { ret 1; }
    if (short.err.short_buffer != 73) { ret 1; }
    i = 0;
    for (i < 73) {
        if (png_enc[i] != 0xA5) { ret 2; }
        i = i + 1;
    }

    src.channels = 2;
    val channels: res[usize, EncodeError] = png_encode(?src, ?png_enc[0], 73);
    if (!sel channels.err)          { ret 3; }
    if (!sel channels.err.channels) { ret 3; }
    ret 0;
}

test "png: encode bound rejects zero and unrepresentable dimensions" {
    val wide: res[usize, EncodeError] = png_encode_bound(0, 1);
    if (!sel wide.err)       { ret 1; }
    if (!sel wide.err.empty) { ret 1; }
    val tall: res[usize, EncodeError] = png_encode_bound(1, 0);
    if (!sel tall.err)       { ret 2; }
    if (!sel tall.err.empty) { ret 2; }
    val huge: res[usize, EncodeError] = png_encode_bound(0xFFFFFFFF, 0xFFFFFFFF);
    if (!sel huge.err)           { ret 3; }
    if (!sel huge.err.too_large) { ret 3; }
    # even where usize can represent the raster, one IDAT cannot exceed 2^31-1.
    val idat: res[usize, EncodeError] = png_encode_bound(0xFFFFFFFF, 1);
    if (!sel idat.err)           { ret 4; }
    if (!sel idat.err.too_large) { ret 4; }
    ret 0;
}

# whether stored_deflate_len of raw_len is want
fun stored_len_is(raw_len: usize, want: usize) u8 {
    val got: opt[usize] = stored_deflate_len(raw_len);
    if (!sel got.some)    { ret 0; }
    if (got.some != want) { ret 0; }
    ret 1;
}

test "png: stored block headers cover empty and length boundaries" {
    if (stored_block_count(0) != 1 || stored_len_is(0, 5) == 0)             { ret 1; }
    if (stored_block_count(1) != 1 || stored_len_is(1, 6) == 0)             { ret 2; }
    if (stored_block_count(65535) != 1 || stored_len_is(65535, 65540) == 0) { ret 3; }
    if (stored_block_count(65536) != 2 || stored_len_is(65536, 65546) == 0) { ret 4; }

    if (write_stored_header(?png_raw[0], 0, 0) != 0) { ret 5; }
    if (png_raw[0] != 1 || png_raw[1] != 0 || png_raw[2] != 0
        || png_raw[3] != 255 || png_raw[4] != 255) { ret 6; }

    if (write_stored_header(?png_raw[0], 0, 1) != 1) { ret 7; }
    if (png_raw[0] != 1 || png_raw[1] != 1 || png_raw[2] != 0
        || png_raw[3] != 254 || png_raw[4] != 255) { ret 8; }

    if (write_stored_header(?png_raw[0], 0, 65535) != 65535) { ret 9; }
    if (png_raw[0] != 1 || png_raw[1] != 255 || png_raw[2] != 255
        || png_raw[3] != 0 || png_raw[4] != 0) { ret 10; }

    if (write_stored_header(?png_raw[0], 0, 65536) != 65535) { ret 11; }
    if (png_raw[0] != 0 || png_raw[1] != 255 || png_raw[2] != 255
        || png_raw[3] != 0 || png_raw[4] != 0) { ret 12; }
    ret 0;
}

# whether img's bound and its encoding into dst are both want bytes
fun encodes_to(img: *Image, dst: *u8, dst_len: usize, want: usize) u8 {
    val bound: res[usize, EncodeError] = png_encode_bound(img.width, img.height);
    if (!sel bound.ok)    { ret 0; }
    if (bound.ok != want) { ret 0; }
    val n: res[usize, EncodeError] = png_encode(img, dst, dst_len);
    if (!sel n.ok)    { ret 0; }
    if (n.ok != want) { ret 0; }
    ret 1;
}

test "png: encode marks an exact 65535-byte stored block final" {
    var i: usize = 0;
    for (i < 52428) {
        png_block_src[i] = (i * 29 + 7)::u8;
        i                = i + 1;
    }

    var src: Image;
    src.pixels     = ?png_block_src[0];
    src.width      = 1;
    src.height     = 13107;
    src.channels   = 4;
    src.colorspace = COLORSPACE_SRGB;

    if (encodes_to(?src, ?png_block_enc[0], 65610, 65603) == 0) { ret 1; }
    if (read_be32(?png_block_enc[0], 33) != 65546)              { ret 3; }

    # zlib header, one final stored header, LEN, and NLEN.
    if (png_block_enc[41] != 0x78 || png_block_enc[42] != 0x01) { ret 4; }
    if (png_block_enc[43] != 1 || png_block_enc[44] != 255 || png_block_enc[45] != 255
        || png_block_enc[46] != 0 || png_block_enc[47] != 0) { ret 5; }

    # width 1 makes each raw row exactly filter byte + four source bytes.
    if (png_block_enc[48] != 0 || png_block_enc[49] != png_block_src[0]
        || png_block_enc[53] != 0 || png_block_enc[54] != png_block_src[4]) { ret 6; }

    if (read_be32(?png_block_enc[0], 65583) != adler.hash(?png_block_enc[48], 65535)) { ret 7; }
    if (read_be32(?png_block_enc[0], 65587) != crc.hash(?png_block_enc[37], 65550))   { ret 8; }
    ret 0;
}

test "png: encode splits stored data after 65535 bytes" {
    var i: usize = 0;
    for (i < 65536) {
        png_block_src[i] = (i * 17 + i / 251)::u8;
        i                = i + 1;
    }

    var src: Image;
    src.pixels     = ?png_block_src[0];
    src.width      = 16384;
    src.height     = 1;
    src.channels   = 4;
    src.colorspace = COLORSPACE_SRGB;

    if (encodes_to(?src, ?png_block_enc[0], 65610, 65610) == 0) { ret 1; }
    if (read_be32(?png_block_enc[0], 33) != 65553)              { ret 3; }

    # the first full block is non-final and the second carries the last 2 bytes.
    if (png_block_enc[43] != 0 || png_block_enc[44] != 255 || png_block_enc[45] != 255
        || png_block_enc[46] != 0 || png_block_enc[47] != 0) { ret 4; }
    if (png_block_enc[65583] != 1 || png_block_enc[65584] != 2 || png_block_enc[65585] != 0
        || png_block_enc[65586] != 253 || png_block_enc[65587] != 255) { ret 5; }
    if (png_block_enc[65588] != png_block_src[65534]
        || png_block_enc[65589] != png_block_src[65535]) { ret 6; }

    var sum: u32 = adler.init();
    sum = adler.update(sum, ?png_block_enc[48], 65535);
    sum = adler.update(sum, ?png_block_enc[65588], 2);
    if (read_be32(?png_block_enc[0], 65590) != sum)                                 { ret 7; }
    if (read_be32(?png_block_enc[0], 65594) != crc.hash(?png_block_enc[37], 65557)) { ret 8; }
    ret 0;
}
